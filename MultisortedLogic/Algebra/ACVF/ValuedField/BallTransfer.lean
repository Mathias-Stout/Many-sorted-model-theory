module

public import MultisortedLogic.Algebra.ACVF.ValuedField.BallFilter
public import MultisortedLogic.Algebra.ACVF.ValuedField.Extend

/-!
# The ball filter of an immediate extension, and its transfer

Step `K(C) = K(M)` of Rideau-Kikuchi's Proposition 2.1.10 compares a generic `a` over a
coefficient field `K(A)` with a generic `b` over its image. The filter to carry is generated by
balls centered at a point of the coefficient field, of radius the distance from `a` to another
point of it. Two things make these the right balls.

* Their radii are **distances**, not arbitrary elements of the value group, so they transfer
  along an embedding: the matching of leading terms of distances (`hsub`, the notes'
  `b ∈ f⋆B`) makes the index sets literally the same, with no image filter to construct.
* Under immediacy they are cofinal among all balls centered in the coefficient field, and by
  the second half of step `K(C) = K(M)` no point of the coefficient field survives in the limit.

## Main definitions

* `ValuationSubring.distBalls`, `ValuationSubring.distFilter` : the filter.

## Main statements

* `ValuationSubring.distIdx_iff` : the two sides have the same index set.
* `ValuationSubring.notMem_limit_distFilter` : the second half of step `K(C) = K(M)` for this
  filter.
* `ValuationSubring.not_meets_map_of_not_meets` : minimality transfers across the embedding.
* `ValuationSubring.exists_common_center` : a polynomial not meeting the filter takes its leading
  term at `a` and at `b` at one and the same point of the coefficient field.
* `ValuationSubring.reflectData_of_immediate_root` : **Step `K(C) = K(M)`**, in its algebraic case.
-/

@[expose] public section

namespace ValuationSubring

open Polynomial

variable {K : Type*} [Field K] {A : ValuationSubring K}
  {R : Type*} [Field R] {φ : R →+* K} {a : K}

variable (A φ a) in
/-- The index of a ball: a center `φ r` and a radius given as the distance from `a` to `φ r'`,
subject to the ball actually containing `a`. -/
def DistIdx (r r' : R) : Prop := A.valuation (a - φ r) < A.valuation (a - φ r')

variable (A φ a) in
/-- The balls centered at a point of the coefficient ring, of radius a distance from `a` to such
a point, containing `a`. -/
def distBalls : Set (Set K) :=
  {s | ∃ r r' : R, DistIdx A φ a r r' ∧ s = A.ball (φ r) (A.valuation (a - φ r'))}

theorem mem_distBalls_iff {s : Set K} :
    s ∈ distBalls A φ a ↔
      ∃ r r' : R, DistIdx A φ a r r' ∧ s = A.ball (φ r) (A.valuation (a - φ r')) := Iff.rfl

/-- Every ball of the family contains `a` — that is what its index says. -/
theorem mem_of_mem_distBalls {s : Set K} (hs : s ∈ distBalls A φ a) : a ∈ s := by
  obtain ⟨r, r', hlt, rfl⟩ := hs
  exact hlt

variable (A φ a) in
/-- Those balls form a ball filter: they all contain `a`, so any two of them are nested. -/
def distFilter (hne : (distBalls A φ a).Nonempty) : BallFilter A where
  carrier := distBalls A φ a
  isBall := by
    rintro s ⟨r, r', -, rfl⟩
    exact ⟨φ r, A.valuation (a - φ r'), rfl⟩
  nonempty' := hne
  directed' := by
    intro s hs t ht
    have has := mem_of_mem_distBalls hs
    have hat := mem_of_mem_distBalls ht
    obtain ⟨r₁, r₁', -, rfl⟩ := hs
    obtain ⟨r₂, r₂', -, rfl⟩ := ht
    rcases le_total (A.valuation (a - φ r₁')) (A.valuation (a - φ r₂')) with h | h
    · exact ⟨_, ⟨r₁, r₁', has, rfl⟩,
        Set.subset_inter (subset_refl _) (ball_subset_ball_of_mem has hat h)⟩
    · exact ⟨_, ⟨r₂, r₂', hat, rfl⟩,
        Set.subset_inter (ball_subset_ball_of_mem hat has h) (subset_refl _)⟩

@[simp]
theorem mem_distFilter {hne} {s : Set K} :
    s ∈ (distFilter A φ a hne).carrier ↔ s ∈ distBalls A φ a := Iff.rfl

/-! ### Immediacy

Immediacy over the coefficient ring says every distance from `a` to a point of it is already the
leading term of a point of it. That is what makes the family nonempty and, by the second half of
step `K(C) = K(M)`, what keeps the coefficient ring out of the limit.
-/

variable (A φ a) in
/-- Immediacy over the image of the coefficient ring, in leading-term form. -/
def ImmediateAt : Prop := ∀ r : R, ∃ d : R, rv (A := A) (a - φ r) = rv (A := A) (φ d)

/-- Failing to be immediate produces an element whose leading term is new. -/
theorem exists_rv_ne_of_not_immediateAt (h : ¬ ImmediateAt A φ a) :
    ∃ r : R, ∀ d : R, rv (A := A) (a - φ r) ≠ rv (A := A) (φ d) := by
  rw [ImmediateAt] at h
  push Not at h
  exact h

/-- Immediacy gives a strictly better approximation `r + d`, at distance exactly `val (a - φ r)`
from the previous one. -/
theorem exists_dist_lt_of_immediateAt (ha : ∀ r : R, a ≠ φ r) (himm : ImmediateAt A φ a)
    (r : R) : ∃ d : R, DistIdx A φ a (r + d) r ∧ A.valuation (φ d) = A.valuation (a - φ r) := by
  obtain ⟨d, hrv⟩ := himm r
  have hne : a - φ r ≠ 0 := sub_ne_zero_of_ne (ha r)
  refine ⟨d, ?_, ?_⟩
  · have h := (rv_eq_iff_valuation_sub_lt hne).mp hrv
    rw [show φ d - (a - φ r) = -(a - φ (r + d)) by rw [map_add]; ring,
      Valuation.map_neg] at h
    exact h
  · rw [← rvVal_rv (A := A) (φ d), ← hrv, rvVal_rv]

theorem distBalls_nonempty (ha : ∀ r : R, a ≠ φ r) (himm : ImmediateAt A φ a) [Nonempty R] :
    (distBalls A φ a).Nonempty := by
  obtain ⟨r⟩ := ‹Nonempty R›
  obtain ⟨d, hidx, -⟩ := exists_dist_lt_of_immediateAt ha himm r
  exact ⟨_, r + d, r, hidx, rfl⟩

/-- **The second half of step `K(C) = K(M)`, for this filter.** No point of the coefficient ring is
a generic. -/
theorem notMem_limit_distFilter (ha : ∀ r : R, a ≠ φ r) (himm : ImmediateAt A φ a)
    {hne} (c : R) : φ c ∉ (distFilter A φ a hne).limit := by
  intro hmem
  obtain ⟨d, hidx, hval⟩ := exists_dist_lt_of_immediateAt ha himm c
  have hball : A.ball (φ (c + d)) (A.valuation (a - φ c))
      ∈ (distFilter A φ a hne).carrier := ⟨c + d, c, hidx, rfl⟩
  have hc := (BallFilter.mem_limit _).mp hmem _ hball
  rw [mem_ball, show φ c - φ (c + d) = -(φ d) by rw [map_add]; ring,
    Valuation.map_neg, hval] at hc
  exact absurd hc (lt_irrefl _)


/-! ### Transfer along an embedding

The index set is the same on both sides, and so is membership of a point of the coefficient
field. So there is one filter, read on the two sides; nothing is constructed on the far side.
-/

section Transfer

variable {L : Type*} [Field L] {AL : ValuationSubring L} {ψ : R →+* L} {b : L}

/-- **The distances transfer**: the distances from `a` to the coefficient field are ordered like
those from `b`. Together with `DistCoeffReflect`, this is all the transfer needs. -/
def DistReflect (φ : R →+* K) (ψ : R →+* L) (A : ValuationSubring K) (AL : ValuationSubring L)
    (a : K) (b : L) : Prop :=
  ∀ r r' : R, A.valuation (a - φ r) < A.valuation (a - φ r')
    ↔ AL.valuation (b - ψ r) < AL.valuation (b - ψ r')

/-- **And so do the mixed comparisons**: a distance against a value of the coefficient field. -/
def DistCoeffReflect (φ : R →+* K) (ψ : R →+* L) (A : ValuationSubring K)
    (AL : ValuationSubring L) (a : K) (b : L) : Prop :=
  ∀ u r : R, A.valuation (φ u) < A.valuation (a - φ r)
    ↔ AL.valuation (ψ u) < AL.valuation (b - ψ r)

variable (hdist : DistReflect φ ψ A AL a b) (hmix : DistCoeffReflect φ ψ A AL a b)
  (hcoeff : CoeffReflect φ ψ A AL)

include hdist in
/-- **The index sets coincide.** -/
theorem distIdx_iff (r r' : R) : DistIdx A φ a r r' ↔ DistIdx AL ψ b r r' := hdist r r'

include hmix in
/-- Membership of a ball by a point of the coefficient field is the same on the two sides. -/
theorem coe_mem_ball_iff' (r r' c : R) :
    φ c ∈ A.ball (φ r) (A.valuation (a - φ r'))
      ↔ ψ c ∈ AL.ball (ψ r) (AL.valuation (b - ψ r')) := by
  rw [mem_ball, mem_ball, show φ c - φ r = φ (c - r) from (map_sub φ c r).symm,
    show ψ c - ψ r = ψ (c - r) from (map_sub ψ c r).symm]
  exact hmix (c - r) r'

include hcoeff in
/-- The strict order of the values of a polynomial at points of the coefficient field is a
comparison of two elements of that field, so it transfers. -/
theorem valuation_eval_lt_iff' (Q : R[X]) (q p : R) :
    A.valuation ((Q.map φ).eval (φ q)) < A.valuation ((Q.map φ).eval (φ p))
      ↔ AL.valuation ((Q.map ψ).eval (ψ q)) < AL.valuation ((Q.map ψ).eval (ψ p)) := by
  rw [eval_map_apply, eval_map_apply, eval_map_apply, eval_map_apply, ← not_le, ← not_le]
  exact not_congr (hcoeff (Q.eval p) (Q.eval q))

include hdist in
/-- Hence so do the inclusions between balls, which are comparisons of radii. -/
theorem valuation_sub_le_iff (r r' : R) :
    A.valuation (a - φ r) ≤ A.valuation (a - φ r')
      ↔ AL.valuation (b - ψ r) ≤ AL.valuation (b - ψ r') := by
  rw [← not_lt, ← not_lt]
  exact not_congr (distIdx_iff hdist r' r)

include hdist hmix in
/-- And so does membership of the limit, for points of the coefficient field. So the second half of
step `K(C) = K(M)` on the near side gives it on the far side, with no immediacy hypothesis there. -/
theorem mem_limit_iff {hneK : (distBalls A φ a).Nonempty} {hneL : (distBalls AL ψ b).Nonempty}
    (c : R) :
    φ c ∈ (distFilter A φ a hneK).limit ↔ ψ c ∈ (distFilter AL ψ b hneL).limit := by
  rw [BallFilter.mem_limit, BallFilter.mem_limit]
  constructor
  · rintro h s ⟨r, r', hidx, rfl⟩
    exact (coe_mem_ball_iff' hmix r r' c).mp
      (h _ ⟨r, r', (distIdx_iff hdist r r').mpr hidx, rfl⟩)
  · rintro h s ⟨r, r', hidx, rfl⟩
    exact (coe_mem_ball_iff' hmix r r' c).mpr
      (h _ ⟨r, r', (distIdx_iff hdist r r').mp hidx, rfl⟩)

include hdist in
theorem distBalls_nonempty_transfer (hneK : (distBalls A φ a).Nonempty) :
    (distBalls AL ψ b).Nonempty := by
  obtain ⟨s, r, r', hidx, rfl⟩ := hneK
  exact ⟨_, r, r', (distIdx_iff hdist r r').mp hidx, rfl⟩

/-- The center of a ball of the family lies in it. -/
theorem center_mem_ball (ha : ∀ r : R, a ≠ φ r) (r r' : R) :
    φ r ∈ A.ball (φ r) (A.valuation (a - φ r')) := by
  rw [mem_ball, sub_self, map_zero]
  exact pos_iff_ne_zero.mpr ((Valuation.ne_zero_iff _).mpr (sub_ne_zero_of_ne (ha r')))

include hdist hmix hcoeff in
/-- **Transfer of non-meeting.** A polynomial that does not meet the near filter does
not meet the far one.

If it met the far one, `valuation_eval_lt_of_meets` would make its valuations strictly decrease
between two centers there; `valuation_eval_lt_iff'` carries that decrease to the near
side; but not meeting the near filter makes its leading term, hence its valuation, constant on
a ball containing both of those centers. -/
theorem not_meets_map_of_not_meets
    (haK : ∀ r : R, a ≠ φ r) (hbL : ∀ r : R, b ≠ ψ r)
    (himm : ImmediateAt A φ a)
    {hneK : (distBalls A φ a).Nonempty} {hneL : (distBalls AL ψ b).Nonempty}
    {Q : R[X]} (hsplitK : (Q.map φ).Splits) (hsplitL : (Q.map ψ).Splits)
    (hK : ¬ (distFilter A φ a hneK).Meets (Q.map φ)) :
    ¬ (distFilter AL ψ b hneL).Meets (Q.map ψ) := by
  classical
  set B := distFilter A φ a hneK with hB
  set B' := distFilter AL ψ b hneL with hB'
  rintro ⟨e, heL, hroot⟩
  -- `Q` is nonzero, else every point is a root and the near filter is met at `a`
  have hQ0 : Q ≠ 0 := by
    rintro rfl
    exact hK ⟨a, (BallFilter.mem_limit _).mpr fun s hs => mem_of_mem_distBalls hs, by simp⟩
  have hQφ : Q.map φ ≠ 0 := Polynomial.map_ne_zero hQ0
  have hQψ : Q.map ψ ≠ 0 := Polynomial.map_ne_zero hQ0
  -- near side: a ball on which the leading term of `Q` is constant
  obtain ⟨s₀, hs₀, hconst⟩ := BallFilter.exists_rv_eval_eq_of_not_meets hsplitK hQφ hK
  obtain ⟨m, m', hidxm, rfl⟩ := id hs₀
  -- far side: a ball inside its partner avoiding every non-generic root of `Q`
  have hs₀' : AL.ball (ψ m) (AL.valuation (b - ψ m')) ∈ B'.carrier :=
    ⟨m, m', (distIdx_iff hdist m m').mp hidxm, rfl⟩
  obtain ⟨s₁, hs₁, hs₁roots⟩ := B'.exists_forall_notMem
    ((Q.map ψ).roots.toFinset.filter fun r => r ∉ B'.limit) (by
      intro r hr
      exact (Finset.mem_filter.mp hr).2)
  obtain ⟨s', hs', hs'sub⟩ := B'.directed' _ hs₀' _ hs₁
  obtain ⟨p, p', hidxp, hpeq⟩ := id hs'
  -- the center `ψ p` is not a generic, by the second half of step `K(C) = K(M)` on the near side
  have hpnot : ψ p ∉ B'.limit := fun h =>
    notMem_limit_distFilter (hne := hneK) haK himm p
      ((mem_limit_iff (hneK := hneK) (hneL := hneL) hdist hmix p).mpr h)
  obtain ⟨u, hu, hpu⟩ := B'.exists_notMem hpnot
  obtain ⟨t', ht', ht'sub⟩ := B'.directed' _ hs' _ hu
  obtain ⟨q, q', hidxq, hqeq⟩ := id ht'
  -- the two centers, and their images on the near side
  have hps' : ψ p ∈ s' := by rw [hpeq]; exact center_mem_ball hbL p p'
  have hqt' : ψ q ∈ t' := by rw [hqeq]; exact center_mem_ball hbL q q'
  have hqs' : ψ q ∈ s' := (ht'sub.trans Set.inter_subset_left) hqt'
  have hpnt : ψ p ∉ t' := fun h => hpu ((ht'sub.trans Set.inter_subset_right) h)
  -- `ψ p` is not a root: it is in `s'`, which avoids non-generic roots, and it is not generic
  have hp0 : (Q.map ψ).eval (ψ p) ≠ 0 := by
    intro h0
    refine hs₁roots (ψ p) (Finset.mem_filter.mpr ⟨?_, hpnot⟩)
      ((hs'sub.trans Set.inter_subset_right) hps')
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hQψ]
    exact h0
  -- far side: the valuation strictly decreases from `ψ p` to `ψ q`
  have hlt : AL.valuation ((Q.map ψ).eval (ψ q)) < AL.valuation ((Q.map ψ).eval (ψ p)) := by
    refine BallFilter.valuation_eval_lt_of_meets hsplitL hs' ht'
      (ht'sub.trans Set.inter_subset_left) ?_ hqt' hps' hpnt ?_ heL hp0
    · intro r hr hrlim
      exact fun hrs => hs₁roots r (Finset.mem_filter.mpr ⟨Multiset.mem_toFinset.mpr hr, hrlim⟩)
        ((hs'sub.trans Set.inter_subset_right) hrs)
    · rw [Polynomial.mem_roots hQψ]
      exact hroot
  -- near side: so it strictly decreases there too, contradicting constancy on `s₀`
  have hltK : A.valuation ((Q.map φ).eval (φ q)) < A.valuation ((Q.map φ).eval (φ p)) :=
    (valuation_eval_lt_iff' hcoeff Q q p).mpr hlt
  have hpK : φ p ∈ A.ball (φ m) (A.valuation (a - φ m')) :=
    (coe_mem_ball_iff' hmix m m' p).mpr
      ((hs'sub.trans Set.inter_subset_left) hps')
  have hqK : φ q ∈ A.ball (φ m) (A.valuation (a - φ m')) :=
    (coe_mem_ball_iff' hmix m m' q).mpr
      ((hs'sub.trans Set.inter_subset_left) hqs')
  have := congrArg (rvVal (A := A)) (hconst _ hqK _ hpK)
  rw [rvVal_rv, rvVal_rv] at this
  exact absurd this (ne_of_lt hltK)

/-! ### Step `K(C) = K(M)`

With the transfer in hand, for each `Q` not meeting the filter one and the same point of the
coefficient field is a center on both sides (`exists_common_center`). The point is found by taking
whichever of the two constancy balls has the smaller radius — radii being distances, the comparison
is the same on both sides, so the smaller ball on the near side has the smaller partner on the far
side. In the algebraic case that is all that is needed (`reflectData_of_immediate_root`); the
transcendental case is done by compactness, in `Algebra/ACVF/FieldStep/Routing.lean`.
-/

include hdist hmix hcoeff in
/-- **A common center.** If `Q` does not meet the near filter, some point of the coefficient
field carries the leading term of `Q` at `a` on the near side and at `b` on the far side. -/
theorem exists_common_center
    (haK : ∀ r : R, a ≠ φ r) (hbL : ∀ r : R, b ≠ ψ r) (himm : ImmediateAt A φ a)
    {hneK : (distBalls A φ a).Nonempty} {hneL : (distBalls AL ψ b).Nonempty}
    {Q : R[X]} (hsplitK : (Q.map φ).Splits) (hsplitL : (Q.map ψ).Splits)
    (hK : ¬ (distFilter A φ a hneK).Meets (Q.map φ)) :
    ∃ c : R, rv (A := A) ((Q.map φ).eval a) = rv (A := A) (φ (Q.eval c)) ∧
      rv (A := AL) ((Q.map ψ).eval b) = rv (A := AL) (ψ (Q.eval c)) := by
  classical
  by_cases hQ0 : Q = 0
  · exact ⟨0, by simp [hQ0], by simp [hQ0]⟩
  have hQφ : Q.map φ ≠ 0 := Polynomial.map_ne_zero hQ0
  have hQψ : Q.map ψ ≠ 0 := Polynomial.map_ne_zero hQ0
  have hL := not_meets_map_of_not_meets (hneL := hneL) hdist hmix hcoeff haK hbL himm
    hsplitK hsplitL hK
  obtain ⟨s₀, hs₀, hconstK⟩ := BallFilter.exists_rv_eval_eq_of_not_meets hsplitK hQφ hK
  obtain ⟨s₁, hs₁, hconstL⟩ := BallFilter.exists_rv_eval_eq_of_not_meets hsplitL hQψ hL
  obtain ⟨m, m', hidxm, rfl⟩ := id hs₀
  obtain ⟨n, n', hidxn, rfl⟩ := id hs₁
  -- the same index set, so the same comparison of radii on both sides
  have hbm : b ∈ AL.ball (ψ m) (AL.valuation (b - ψ m')) := (distIdx_iff hdist m m').mp hidxm
  have han : a ∈ A.ball (φ n) (A.valuation (a - φ n')) :=
    (distIdx_iff hdist n n').mpr hidxn
  -- one index whose ball sits inside the near constancy ball and whose partner sits inside
  -- the far one; the smaller radius does it, and radii compare the same way on both sides
  have key : ∀ u u' : R, a ∈ A.ball (φ u) (A.valuation (a - φ u')) →
      b ∈ AL.ball (ψ u) (AL.valuation (b - ψ u')) →
      A.ball (φ u) (A.valuation (a - φ u')) ⊆ A.ball (φ m) (A.valuation (a - φ m')) →
      AL.ball (ψ u) (AL.valuation (b - ψ u')) ⊆ AL.ball (ψ n) (AL.valuation (b - ψ n')) →
      ∃ c : R, rv (A := A) ((Q.map φ).eval a) = rv (A := A) (φ (Q.eval c)) ∧
        rv (A := AL) ((Q.map ψ).eval b) = rv (A := AL) (ψ (Q.eval c)) := by
    intro u u' hau hbu hKsub hLsub
    refine ⟨u, ?_, ?_⟩
    · rw [← eval_map_apply]
      exact hconstK a (hKsub hau) (φ u) (hKsub (center_mem_ball haK u u'))
    · rw [← eval_map_apply]
      exact hconstL b (hLsub hbu) (ψ u) (hLsub (center_mem_ball hbL u u'))
  rcases le_total (A.valuation (a - φ m')) (A.valuation (a - φ n')) with h | h
  · exact key m m' hidxm hbm (subset_refl _)
      (ball_subset_ball_of_mem hbm hidxn ((valuation_sub_le_iff hdist m' n').mp h))
  · exact key n n' han hidxn (ball_subset_ball_of_mem han hidxm h) (subset_refl _)

include hdist hmix hcoeff in
/-- **Step `K(C) = K(M)`, algebraic case**, as a reflection. If `a` is a root of a monic `P` over
the coefficient field minimal among those meeting the filter, and `b` is a root of its image, then
the order of the values of polynomials is the same at `a` and at `b`: every polynomial is first
reduced modulo `P`, and below the minimal degree nothing meets the filter. -/
theorem reflectData_of_immediate_root [IsAlgClosed K] [IsAlgClosed L]
    (haK : ∀ r : R, a ≠ φ r) (hbL : ∀ r : R, b ≠ ψ r) (himm : ImmediateAt A φ a)
    {hneK : (distBalls A φ a).Nonempty} {hneL : (distBalls AL ψ b).Nonempty}
    {P : R[X]} (hP : P.Monic) (hn : 0 < P.natDegree)
    (hPa : (P.map φ).eval a = 0) (hPb : (P.map ψ).eval b = 0)
    (hmin : ∀ Q : R[X], Q ≠ 0 → Q.natDegree < P.natDegree →
      ¬ (distFilter A φ a hneK).Meets (Q.map φ)) :
    ReflectData φ ψ A AL a b := by
  have hPa' : evalOn φ a P = 0 := by
    rw [show evalOn φ a P = (P.map φ).eval a from (Polynomial.eval_map _ _).symm]; exact hPa
  have hPb' : evalOn' ψ b P = 0 := by
    rw [show evalOn' ψ b P = (P.map ψ).eval b from (Polynomial.eval_map _ _).symm]; exact hPb
  have hcent : ∀ S : R[X], S.natDegree < P.natDegree → ∃ c : R,
      A.valuation (evalOn φ a S) = A.valuation (φ (S.eval c)) ∧
        AL.valuation (evalOn' ψ b S) = AL.valuation (ψ (S.eval c)) := by
    intro S hS
    by_cases hS0 : S = 0
    · exact ⟨0, by simp [hS0], by simp [hS0]⟩
    obtain ⟨c, hcK, hcL⟩ := exists_common_center hdist hmix hcoeff haK hbL himm
      (hneL := hneL) (IsAlgClosed.splits _) (IsAlgClosed.splits _) (hmin S hS0 hS)
    refine ⟨c, ?_, ?_⟩
    · rw [show evalOn φ a S = (S.map φ).eval a from (Polynomial.eval_map _ _).symm,
        ← rvVal_rv (A := A), hcK, rvVal_rv]
    · rw [show evalOn' ψ b S = (S.map ψ).eval b from (Polynomial.eval_map _ _).symm,
        ← rvVal_rv (A := AL), hcL, rvVal_rv]
  refine ⟨fun S T => ?_⟩
  obtain ⟨S', hS'n, hS'K, hS'L⟩ := exists_reduced_of_monic hP hn le_rfl hPa' hPb' S
  obtain ⟨T', hT'n, hT'K, hT'L⟩ := exists_reduced_of_monic hP hn le_rfl hPa' hPb' T
  obtain ⟨c, hvKS, hvLS⟩ := hcent S' hS'n
  obtain ⟨c', hvKT, hvLT⟩ := hcent T' hT'n
  rw [hS'K, hT'K, hS'L, hT'L, hvKS, hvKT, hvLS, hvLT]
  exact hcoeff _ _

end Transfer

end ValuationSubring
