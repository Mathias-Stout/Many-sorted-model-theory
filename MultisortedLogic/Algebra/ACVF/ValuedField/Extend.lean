/-!
# Extending an embedding along an element with a prescribed `rv`-type

This is the `rv`-form of the following lemma on valued fields:

> Suppose `f : A ↪ L` is an embedding of valued fields. If `a ∈ K` and `b ∈ L` are such that
> for every polynomial `p ∈ A[x]` we have `v (p a) = w (p b)`, then `f` extends to a valued
> ring embedding `f : A[a] ↪ L`.

Here the hypothesis is strengthened from valuations to leading terms, because an embedding of
`L_RV`-structures has to commute with `rv`, which is finer than `v`. Concretely, the data is a
coefficient ring `R` mapped into both valued fields, an element `a` on one side, an element `b`
on the other, and a map `fRV` of leading term structures; the hypothesis `RvTypeEq` says that
`fRV` carries the leading term of `p a` to the leading term of `p b`, for every `p`.

Since `rv x = 0 ↔ x = 0`, an injective `fRV` forces the two evaluation maps to have the same
kernel, which is exactly the well-definedness of `p a ↦ p b`.

## Main statements

* `ValuationSubring.RvTypeEq` : the hypothesis.
* `ValuationSubring.eval_eq_zero_iff` : `p a = 0 ↔ p b = 0`.
* `ValuationSubring.eval_eq_iff` : `p a = q a ↔ p b = q b`.
* `ValuationSubring.extend` : the induced ring map `R[a] → L`, with `extend_eval`.
* `ValuationSubring.extend_injective`, `ValuationSubring.rv_extend` : it is an embedding of
  valued rings.
* `ValuationSubring.rvTypeEq_of_modByMonic` : reduction modulo a monic minimal polynomial.
* `ValuationSubring.rv_eval_eq_of_ramified_transfer` : the ramified computation, transferred.
* `ValuationSubring.rvTypeEq_of_ramified` : Proposition 2.1.3(3), the purely ramified extension
  step.
-/

@[expose] public section

namespace ValuationSubring

open Polynomial

variable {K L : Type*} [Field K] [Field L] {AK : ValuationSubring K} {AL : ValuationSubring L}
  {R : Type*} [CommRing R] (φ : R →+* K) (ψ : R →+* L) (a : K) (b : L)

/-- Evaluation of `R`-polynomials at `a`, through `φ`. -/
noncomputable abbrev evalOn : R[X] →+* K := eval₂RingHom φ a

/-- Evaluation of `R`-polynomials at `b`, through `ψ`. -/
noncomputable abbrev evalOn' : R[X] →+* L := eval₂RingHom ψ b

/-- The ring `F[x]` generated by `x` over a subfield `F`, the range of `evalOn`, contains `F`. -/
theorem mem_evalOn_range_of_mem (F : Subfield K) (x : K) {y : K} (hy : y ∈ F) :
    y ∈ (evalOn F.subtype x).range :=
  RingHom.mem_range.mpr ⟨C ⟨y, hy⟩, by simp⟩

/-- The ring `F[x]` generated by `x` over a subfield `F` contains `x`. -/
theorem self_mem_evalOn_range (F : Subfield K) (x : K) : x ∈ (evalOn F.subtype x).range :=
  RingHom.mem_range.mpr ⟨X, by simp⟩

variable {φ ψ a b}

/-- `b` has the same leading term type over `ψ` as `a` has over `φ`, as measured by `fRV`. -/
def RvTypeEq (fRV : AK.RV →*₀ AL.RV) (φ : R →+* K) (ψ : R →+* L) (a : K) (b : L) : Prop :=
  ∀ p : R[X], fRV (rv (A := AK) (evalOn φ a p)) = rv (A := AL) (evalOn' ψ b p)

variable {fRV : AK.RV →*₀ AL.RV} (hinj : Function.Injective fRV)
  (H : RvTypeEq fRV φ ψ a b)

include hinj H in
/-- A polynomial vanishes at `a` exactly when it vanishes at `b`. -/
theorem eval_eq_zero_iff (p : R[X]) : evalOn φ a p = 0 ↔ evalOn' ψ b p = 0 := by
  rw [← rv_eq_zero_iff (A := AK), ← rv_eq_zero_iff (A := AL), ← H p]
  constructor
  · intro h; rw [h, map_zero]
  · intro h; exact hinj (by rw [h, map_zero])

include hinj H in
/-- Evaluation at `a` determines evaluation at `b`: the assignment `p a ↦ p b` is well-defined
and injective. -/
theorem eval_eq_iff (p q : R[X]) : evalOn φ a p = evalOn φ a q ↔ evalOn' ψ b p = evalOn' ψ b q := by
  rw [← sub_eq_zero, ← sub_eq_zero (a := evalOn' ψ b p), ← map_sub, ← map_sub]
  exact eval_eq_zero_iff hinj H (p - q)

/-- The extension of `ψ` to the subring `R[a]` generated by `a`, sending `p a` to `p b`. -/
noncomputable def extend : (evalOn φ a).range →+* L :=
  (Ideal.Quotient.lift _ (evalOn' ψ b)
      (fun p hp => (eval_eq_zero_iff hinj H p).mp hp)).comp
    (RingHom.quotientKerEquivRange (evalOn φ a)).symm.toRingHom

include hinj H in
@[simp]
theorem extend_eval (p : R[X]) :
    extend hinj H ((evalOn φ a).rangeRestrict p) = evalOn' ψ b p := by
  simp [extend, RingHom.quotientKerEquivRange]

include hinj H in
/-- The extension is injective, since `p a = q a` exactly when `p b = q b`. -/
theorem extend_injective : Function.Injective (extend hinj H) := by
  intro x y hxy
  obtain ⟨p, hp⟩ := x.2
  obtain ⟨q, hq⟩ := y.2
  have hx : x = (evalOn φ a).rangeRestrict p := Subtype.ext hp.symm
  have hy : y = (evalOn φ a).rangeRestrict q := Subtype.ext hq.symm
  subst hx
  subst hy
  rw [extend_eval hinj H p, extend_eval hinj H q] at hxy
  exact Subtype.ext ((eval_eq_iff hinj H p q).mpr hxy)

include hinj H in
/-- The extension preserves leading terms: it is an embedding of valued rings. -/
theorem rv_extend (x : (evalOn φ a).range) :
    fRV (rv (A := AK) (x : K)) = rv (A := AL) (extend hinj H x) := by
  obtain ⟨p, hp⟩ := x.2
  have hx : x = (evalOn φ a).rangeRestrict p := Subtype.ext hp.symm
  subst hx
  rw [extend_eval hinj H p]
  exact H p

/-- **The extension of `ψ` to `R[a]`, from the kernel condition alone.** `extend` obtains the
inclusion of kernels from a map of leading-term structures; but in the steps that *construct*
such a map the inclusion is available first, proved directly, and this is the form they need. -/
noncomputable def extendOfKer (hker : ∀ p : R[X], evalOn φ a p = 0 → evalOn' ψ b p = 0) :
    (evalOn φ a).range →+* L :=
  (Ideal.Quotient.lift _ (evalOn' ψ b) fun p hp => hker p hp).comp
    (RingHom.quotientKerEquivRange (evalOn φ a)).symm.toRingHom

@[simp]
theorem extendOfKer_eval (hker : ∀ p : R[X], evalOn φ a p = 0 → evalOn' ψ b p = 0) (p : R[X]) :
    extendOfKer hker ((evalOn φ a).rangeRestrict p) = evalOn' ψ b p := by
  simp [extendOfKer, RingHom.quotientKerEquivRange]

/-- Every element of `R[a]` is `p a` for some `p`, and its image is `p b`. -/
theorem extendOfKer_apply (hker : ∀ p : R[X], evalOn φ a p = 0 → evalOn' ψ b p = 0)
    (x : (evalOn φ a).range) {p : R[X]} (hp : evalOn φ a p = (x : K)) :
    extendOfKer hker x = evalOn' ψ b p := by
  rw [show x = (evalOn φ a).rangeRestrict p from Subtype.ext hp.symm, extendOfKer_eval]


section Reduction

variable {fRV : AK.RV →*₀ AL.RV}

/-- **Reduction modulo a minimal polynomial.** If `a` and `b` are roots of the same monic
polynomial over the coefficient ring, it is enough to match leading terms in degrees below it:
every polynomial reduces modulo the monic one without changing its value at `a` or at `b`.

Both algebraic cases of Rideau-Kikuchi's proof go through this lemma — the residual case with an
exact lifting of the minimal polynomial of the residue, the ramified case with `Xⁿ - c`. -/
theorem rvTypeEq_of_modByMonic {P : R[X]} (hP : P.Monic)
    (hPa : evalOn φ a P = 0) (hPb : evalOn' ψ b P = 0)
    (H : ∀ Q : R[X], Q.natDegree < P.natDegree →
      fRV (rv (A := AK) (evalOn φ a Q)) = rv (A := AL) (evalOn' ψ b Q)) :
    RvTypeEq fRV φ ψ a b := by
  have : Nontrivial R := φ.domain_nontrivial
  intro Q
  -- evaluating `Q` and its remainder modulo `P` gives the same value on both sides
  have hKa : evalOn φ a Q = evalOn φ a (Q %ₘ P) := by
    conv_lhs => rw [← Polynomial.modByMonic_add_div Q P]
    rw [map_add, map_mul, hPa, zero_mul, add_zero]
  have hKb : evalOn' ψ b Q = evalOn' ψ b (Q %ₘ P) := by
    conv_lhs => rw [← Polynomial.modByMonic_add_div Q P]
    rw [map_add, map_mul, hPb, zero_mul, add_zero]
  rw [hKa, hKb]
  by_cases h0 : Q %ₘ P = 0
  · simp [h0]
  · exact H _ (Polynomial.natDegree_lt_natDegree h0 (Polynomial.degree_modByMonic_lt Q hP))

end Reduction


/-! ### The one reflection property

Everything the extension needs follows from a single statement about `a` and `b`: **the order of
the values of polynomials is the same on the two sides**. This is essentially the hypothesis of
the valued-field lemma quoted at the top of this file. It may look too weak, since an
`L_RV`-embedding must commute with `rv`, which is finer than `v`. But read as a *reflection* it
is enough, because `rv x = rv y` **is** a comparison of values:

  `rv x = rv y ↔ v (y - x) < v x`   (`rv_eq_iff_valuation_sub_lt`)

so the leading terms of `P a` and `Q a` agree exactly when `v ((Q - P) a) < v (P a)`, and that is
an instance of the hypothesis. The kernel condition is another instance, at `Q = 0`. -/

section Reflect

/-- **The reflection of the order of values of polynomials.** The one hypothesis every case of
the extension has to establish. -/
structure ReflectData (φ : R →+* K) (ψ : R →+* L) (AK : ValuationSubring K)
    (AL : ValuationSubring L) (a : K) (b : L) : Prop where
  /-- The order of the values of polynomials is the same at `a` and at `b`. -/
  valLe : ∀ P Q : R[X], AK.valuation (evalOn φ a P) ≤ AK.valuation (evalOn φ a Q)
    ↔ AL.valuation (evalOn' ψ b P) ≤ AL.valuation (evalOn' ψ b Q)

namespace ReflectData

variable {φ : R →+* K} {ψ : R →+* L} {a : K} {b : L} (h : ReflectData φ ψ AK AL a b)

include h

/-- **A polynomial vanishes at `a` exactly when it vanishes at `b`** — the kernel condition
`extendOfKer` asks for, at `Q = 0`. -/
theorem evalZero (P : R[X]) : evalOn φ a P = 0 ↔ evalOn' ψ b P = 0 := by
  have hK : AK.valuation (evalOn φ a P) ≤ AK.valuation (evalOn φ a 0) ↔ evalOn φ a P = 0 := by
    rw [map_zero, map_zero]
    exact ⟨fun hc => (Valuation.zero_iff _).mp (le_antisymm hc zero_le),
      fun hc => by rw [hc, map_zero]⟩
  have hL : AL.valuation (evalOn' ψ b P) ≤ AL.valuation (evalOn' ψ b 0)
      ↔ evalOn' ψ b P = 0 := by
    rw [map_zero, map_zero]
    exact ⟨fun hc => (Valuation.zero_iff _).mp (le_antisymm hc zero_le),
      fun hc => by rw [hc, map_zero]⟩
  rw [← hK, ← hL]
  exact h.valLe P 0

/-- The strict order transfers too, a linear order making that free. -/
theorem valLt (P Q : R[X]) :
    AK.valuation (evalOn φ a P) < AK.valuation (evalOn φ a Q)
      ↔ AL.valuation (evalOn' ψ b P) < AL.valuation (evalOn' ψ b Q) := by
  rw [← not_le, ← not_le, not_iff_not]
  exact h.valLe Q P

/-- **And so do leading terms**, since `rv x = rv y` is the comparison `v (y - x) < v x`. -/
theorem rvEq (P Q : R[X]) :
    rv (A := AK) (evalOn φ a P) = rv (A := AK) (evalOn φ a Q)
      ↔ rv (A := AL) (evalOn' ψ b P) = rv (A := AL) (evalOn' ψ b Q) := by
  by_cases hP : evalOn φ a P = 0
  · rw [hP, (h.evalZero P).mp hP, map_zero, map_zero]
    exact ⟨fun hc => by
        rw [(rv_eq_zero_iff (A := AL)).mpr ((h.evalZero Q).mp
          ((rv_eq_zero_iff (A := AK)).mp hc.symm))],
      fun hc => by
        rw [(rv_eq_zero_iff (A := AK)).mpr ((h.evalZero Q).mpr
          ((rv_eq_zero_iff (A := AL)).mp hc.symm))]⟩
  · have hPb : evalOn' ψ b P ≠ 0 := fun hc => hP ((h.evalZero P).mpr hc)
    rw [rv_eq_iff_valuation_sub_lt (A := AK) hP, rv_eq_iff_valuation_sub_lt (A := AL) hPb,
      show evalOn φ a Q - evalOn φ a P = evalOn φ a (Q - P) from (map_sub _ _ _).symm,
      show evalOn' ψ b Q - evalOn' ψ b P = evalOn' ψ b (Q - P) from (map_sub _ _ _).symm]
    exact h.valLt (Q - P) P

/-- Hence the homomorphism of `R[a]` sending `p a` to `p b`. -/
noncomputable def extend : (evalOn φ a).range →+* L :=
  extendOfKer (fun p hp => (h.evalZero p).mp hp)

theorem extend_apply (x : (evalOn φ a).range) {p : R[X]} (hp : evalOn φ a p = (x : K)) :
    h.extend x = evalOn' ψ b p :=
  extendOfKer_apply _ x hp

end ReflectData

/-- **The order of values on the coefficient ring is the same on both sides.** This is what a
`FieldEmbeddingData` on the coefficient field supplies, and every case of the extension starts
from it. -/
def CoeffReflect (φ : R →+* K) (ψ : R →+* L) (AK : ValuationSubring K)
    (AL : ValuationSubring L) : Prop :=
  ∀ r r' : R, AK.valuation (φ r) ≤ AK.valuation (φ r')
    ↔ AL.valuation (ψ r) ≤ AL.valuation (ψ r')

namespace CoeffReflect

variable {φ : R →+* K} {ψ : R →+* L} (h : CoeffReflect φ ψ AK AL)

include h

/-- The strict order transfers too, a linear order making that free. -/
theorem lt_iff (r r' : R) :
    AK.valuation (φ r) < AK.valuation (φ r') ↔ AL.valuation (ψ r) < AL.valuation (ψ r') := by
  rw [← not_le, ← not_le]
  exact not_congr (h r' r)

/-- And so does equality. -/
theorem eq_iff (r r' : R) :
    AK.valuation (φ r) = AK.valuation (φ r') ↔ AL.valuation (ψ r) = AL.valuation (ψ r') :=
  ⟨fun hr => le_antisymm ((h r r').mp (le_of_eq hr)) ((h r' r).mp (le_of_eq hr.symm)),
    fun hr => le_antisymm ((h r r').mpr (le_of_eq hr)) ((h r' r).mpr (le_of_eq hr.symm))⟩

/-- **A maximum of two values of the coefficient field transfers.** This is what says that a
non-canceling sum of two such values stays non-canceling on the far side. -/
theorem max_congr {x y z : R}
    (hx : AK.valuation (φ x) = max (AK.valuation (φ y)) (AK.valuation (φ z))) :
    AL.valuation (ψ x) = max (AL.valuation (ψ y)) (AL.valuation (ψ z)) := by
  rcases le_total (AK.valuation (φ y)) (AK.valuation (φ z)) with hle | hle
  · rw [max_eq_right hle] at hx
    rw [max_eq_right ((h y z).mp hle)]
    exact (h.eq_iff x z).mp hx
  · rw [max_eq_left hle] at hx
    rw [max_eq_left ((h z y).mp hle)]
    exact (h.eq_iff x y).mp hx

end CoeffReflect

/-- **Reduction modulo a monic polynomial that both `a` and `b` satisfy.** Every polynomial then
has a representative of degree below `n` with the same value at `a` and at `b`, which is how the
algebraic cases get from a degree-bounded reflection to an unbounded one. -/
theorem exists_reduced_of_monic {P₀ : R[X]} (hP₀ : P₀.Monic) {n : ℕ} (hn : 0 < n)
    (hP₀n : P₀.natDegree ≤ n) (hPa : evalOn φ a P₀ = 0) (hPb : evalOn' ψ b P₀ = 0) (S : R[X]) :
    ∃ S' : R[X], S'.natDegree < n ∧ evalOn φ a S = evalOn φ a S' ∧
      evalOn' ψ b S = evalOn' ψ b S' := by
  have : Nontrivial R := φ.domain_nontrivial
  refine ⟨S %ₘ P₀, ?_, ?_, ?_⟩
  · by_cases h0 : S %ₘ P₀ = 0
    · rw [h0, Polynomial.natDegree_zero]
      exact hn
    · exact lt_of_lt_of_le
        (Polynomial.natDegree_lt_natDegree h0 (Polynomial.degree_modByMonic_lt S hP₀)) hP₀n
  · conv_lhs => rw [← Polynomial.modByMonic_add_div S P₀]
    rw [map_add, map_mul, hPa, zero_mul, add_zero]
  · conv_lhs => rw [← Polynomial.modByMonic_add_div S P₀]
    rw [map_add, map_mul, hPb, zero_mul, add_zero]

end Reflect


/-! ### The ramified case without a map of leading-term structures

`rvTypeEq_of_ramified` presupposes a map `fRV` of leading-term structures. The steps that have to
*construct* such a map cannot use it: the map is what is being built. This section restates the
ramified computation with `fRV` replaced by a **reflection property** — the order of the values of
the monomials corresponds (`RamifiedMono`) — and concludes `ReflectData` for every polynomial in
`a`. Together with `extendOfKer` that is enough to produce the homomorphism of `R[a]` and to see
that *it* reflects leading terms.

The hypotheses are the ones the ramified case has anyway, with the domination strengthened to an
equivalence — which is how it arrives, since an embedding reflects the order relation. Notably no
relation between the leading terms of `a` and of `b` is needed: below the ramification order the
degree of the dominant monomial is determined by the value, so the two sides match degree by
degree. -/

section RamifiedReflect

variable {R : Type*} [Field R] {φ : R →+* K} {ψ : R →+* L} {a : K} {b : L} {n : ℕ}


/-- The domination hypothesis, as an equivalence: the monomials `φ r · aⁱ` are ordered by value
exactly as the monomials `ψ r · bⁱ` are. -/
def RamifiedMono (φ : R →+* K) (ψ : R →+* L) (AK : ValuationSubring K)
    (AL : ValuationSubring L) (a : K) (b : L) : Prop :=
  ∀ (r r' : R) (i i' : ℕ),
    AK.valuation (φ r) * AK.valuation a ^ i < AK.valuation (φ r') * AK.valuation a ^ i'
      ↔ AL.valuation (ψ r) * AL.valuation b ^ i < AL.valuation (ψ r') * AL.valuation b ^ i'

/-- The domination hypothesis **with the coefficients and the degrees bounded**: only the
monomials `φ r · aⁱ` with `r` in a prescribed set and `i` below a prescribed bound have to be
ordered like their partners.

This is what the *finite* fragment of the ramified case of infinite order needs: the value of the
far-side element has to realize the cut that `val a` makes in the group generated by the finitely
many coefficient values with denominators up to the degree bound, which a divisible value group
always allows, whereas the whole cut may be unattainable in the target. -/
def RamifiedMonoOn (C : Set R) (n : ℕ) (φ : R →+* K) (ψ : R →+* L) (AK : ValuationSubring K)
    (AL : ValuationSubring L) (a : K) (b : L) : Prop :=
  ∀ r ∈ C, ∀ r' ∈ C, ∀ i < n, ∀ i' < n,
    AK.valuation (φ r) * AK.valuation a ^ i < AK.valuation (φ r') * AK.valuation a ^ i'
      ↔ AL.valuation (ψ r) * AL.valuation b ^ i < AL.valuation (ψ r') * AL.valuation b ^ i'

theorem RamifiedMono.on (h : RamifiedMono φ ψ AK AL a b) {C : Set R} {n : ℕ} :
    RamifiedMonoOn C n φ ψ AK AL a b := fun r _ r' _ i _ i' _ => h r r' i i'

/-- The domination hypothesis in the **one direction** the dominant-monomial argument uses:
near-side domination is carried to the far side. `RamifiedMonoOn` is the same thing as an
equivalence, which is how it arrives, an embedding reflecting the order; but
`exists_dominant_of_ramified` needs no more than this. -/
def RamifiedDom (C : Set R) (n : ℕ) (φ : R →+* K) (ψ : R →+* L) (AK : ValuationSubring K)
    (AL : ValuationSubring L) (a : K) (b : L) : Prop :=
  ∀ r ∈ C, ∀ r' ∈ C, ∀ i < n, ∀ i' < n,
    AK.valuation (φ r) * AK.valuation a ^ i < AK.valuation (φ r') * AK.valuation a ^ i' →
      AL.valuation (ψ r) * AL.valuation b ^ i < AL.valuation (ψ r') * AL.valuation b ^ i'

theorem RamifiedMonoOn.dom {C : Set R} {n : ℕ} (h : RamifiedMonoOn C n φ ψ AK AL a b) :
    RamifiedDom C n φ ψ AK AL a b :=
  fun r hr r' hr' i hi i' hi' => (h r hr r' hr' i hi i' hi').mp

section Bounded

variable {C : Set R} (hmono : RamifiedMonoOn C n φ ψ AK AL a b)

include hmono

omit hmono in
/-- **The dominant monomial, on both sides at once.** In the ramified situation the same index
dominates `Q` at `a` and at `b`, so both leading terms are read off the same coefficient. -/
theorem exists_dominant_of_ramified (htr : RamifiedDom C n φ ψ AK AL a b) (ha : a ≠ 0)
    (hord : ∀ k, 0 < k → k < n → AK.valuation a ^ k ∉ AK.valuation '' (φ.fieldRange : Set K))
    {Q : R[X]} (hQ : Q ≠ 0) (hQn : Q.natDegree < n) (hQC : ∀ i, Q.coeff i ∈ C) :
    ∃ i₀ ∈ Q.support,
      rv (A := AK) (evalOn φ a Q) = rv (A := AK) (φ (Q.coeff i₀)) * rv (A := AK) a ^ i₀ ∧
        rv (A := AL) (evalOn' ψ b Q)
          = rv (A := AL) (ψ (Q.coeff i₀)) * rv (A := AL) b ^ i₀ := by
  have hevK : evalOn φ a Q = (Q.map φ).eval a := (Polynomial.eval_map _ _).symm
  have hevL : evalOn' ψ b Q = (Q.map ψ).eval b := (Polynomial.eval_map _ _).symm
  have hQK : Q.map φ ≠ 0 := Polynomial.map_ne_zero hQ
  have hQKF : ∀ i, (Q.map φ).coeff i ∈ φ.fieldRange := by
    intro i; rw [Polynomial.coeff_map]; exact ⟨Q.coeff i, rfl⟩
  have hQKn : (Q.map φ).natDegree < n := by rwa [Polynomial.natDegree_map]
  obtain ⟨i₀, hi₀, hdom, hrvK⟩ := rv_eval_eq_of_ramified (A := AK) ha hord hQK hQKF hQKn
  have hi₀' : i₀ ∈ Q.support := (mem_support_map_of_injective φ.injective).mp hi₀
  refine ⟨i₀, hi₀', by rw [hevK, hrvK, Polynomial.coeff_map], ?_⟩
  have hdomL : ∀ i ∈ (Q.map ψ).support, i ≠ i₀ →
      AL.valuation ((Q.map ψ).coeff i * b ^ i)
        < AL.valuation ((Q.map ψ).coeff i₀ * b ^ i₀) := by
    intro i hi hii
    have hiK : i ∈ (Q.map φ).support :=
      (mem_support_map_of_injective φ.injective).mpr
        ((mem_support_map_of_injective ψ.injective).mp hi)
    have hin : i < n := lt_of_le_of_lt
      (le_trans (Polynomial.le_natDegree_of_mem_supp i hiK)
        (le_of_eq (Polynomial.natDegree_map _))) hQn
    have hi₀n : i₀ < n := lt_of_le_of_lt
      (le_trans (Polynomial.le_natDegree_of_mem_supp i₀ hi₀)
        (le_of_eq (Polynomial.natDegree_map _))) hQn
    rw [map_mul, map_mul, map_pow, map_pow]
    simpa only [Polynomial.coeff_map] using
      htr (Q.coeff i) (hQC i) (Q.coeff i₀) (hQC i₀) i hin i₀ hi₀n (by
        simpa only [Polynomial.coeff_map] using hdom i hiK hii)
  rw [hevL, rv_eval_eq_of_lt ((mem_support_map_of_injective ψ.injective).mpr hi₀') hdomL, map_mul,
    map_pow, Polynomial.coeff_map]

/-- **The order of values transfers, in both directions**, for monomials: `hmono` with the strict
order replaced by the weak one, which a linear order makes free. -/
theorem valuation_monomial_le_iff_of_ramified {r r' : R} (hr : r ∈ C) (hr' : r' ∈ C)
    {i i' : ℕ} (hi : i < n) (hi' : i' < n) :
    AK.valuation (φ r) * AK.valuation a ^ i ≤ AK.valuation (φ r') * AK.valuation a ^ i'
      ↔ AL.valuation (ψ r) * AL.valuation b ^ i ≤ AL.valuation (ψ r') * AL.valuation b ^ i' := by
  rw [← not_lt, ← not_lt, not_iff_not]
  exact hmono r' hr' r hr i' hi' i hi

/-- Below the ramification order a nonzero polynomial does not vanish, on either side. -/
theorem eval_ne_zero_of_ramified (ha : a ≠ 0) (hb : b ≠ 0)
    (hord : ∀ k, 0 < k → k < n → AK.valuation a ^ k ∉ AK.valuation '' (φ.fieldRange : Set K))
    {Q : R[X]} (hQ : Q ≠ 0) (hQn : Q.natDegree < n) (hQC : ∀ i, Q.coeff i ∈ C) :
    evalOn φ a Q ≠ 0 ∧ evalOn' ψ b Q ≠ 0 := by
  obtain ⟨i₀, hi₀, hK, hL⟩ := exists_dominant_of_ramified hmono.dom ha hord hQ hQn hQC
  have hc0 : Q.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀
  constructor
  · rw [ne_eq, ← rv_eq_zero_iff (A := AK), hK]
    refine mul_ne_zero ?_ (pow_ne_zero _ (by rwa [ne_eq, rv_eq_zero_iff]))
    rw [ne_eq, rv_eq_zero_iff, map_eq_zero_iff φ φ.injective]
    exact hc0
  · rw [ne_eq, ← rv_eq_zero_iff (A := AL), hL]
    refine mul_ne_zero ?_ (pow_ne_zero _ (by rwa [ne_eq, rv_eq_zero_iff]))
    rw [ne_eq, rv_eq_zero_iff, map_eq_zero_iff ψ ψ.injective]
    exact hc0

/-- **The order of values corresponds, below the ramification order.** -/
theorem valuation_le_iff_of_ramified (ha : a ≠ 0) (hb : b ≠ 0)
    (hord : ∀ k, 0 < k → k < n → AK.valuation a ^ k ∉ AK.valuation '' (φ.fieldRange : Set K))
    {P Q : R[X]} (hP : P.natDegree < n) (hQ : Q.natDegree < n)
    (hPC : ∀ i, P.coeff i ∈ C) (hQC : ∀ i, Q.coeff i ∈ C) :
    AK.valuation (evalOn φ a P) ≤ AK.valuation (evalOn φ a Q)
      ↔ AL.valuation (evalOn' ψ b P) ≤ AL.valuation (evalOn' ψ b Q) := by
  by_cases hP0 : P = 0
  · subst hP0
    simp only [map_zero]
    exact ⟨fun _ => zero_le, fun _ => zero_le⟩
  by_cases hQ0 : Q = 0
  · subst hQ0
    obtain ⟨h1, h2⟩ := eval_ne_zero_of_ramified hmono ha hb hord hP0 hP hPC
    simp only [map_zero]
    exact ⟨fun h => absurd ((Valuation.zero_iff _).mp (le_antisymm h zero_le)) h1,
      fun h => absurd ((Valuation.zero_iff _).mp (le_antisymm h zero_le)) h2⟩
  obtain ⟨i, hi, hKP, hLP⟩ := exists_dominant_of_ramified hmono.dom ha hord hP0 hP hPC
  obtain ⟨j, hj, hKQ, hLQ⟩ := exists_dominant_of_ramified hmono.dom ha hord hQ0 hQ hQC
  have hvKP : AK.valuation (evalOn φ a P)
      = AK.valuation (φ (P.coeff i)) * AK.valuation a ^ i := by
    rw [← rvVal_rv (A := AK), hKP, map_mul, map_pow, rvVal_rv, rvVal_rv]
  have hvKQ : AK.valuation (evalOn φ a Q)
      = AK.valuation (φ (Q.coeff j)) * AK.valuation a ^ j := by
    rw [← rvVal_rv (A := AK), hKQ, map_mul, map_pow, rvVal_rv, rvVal_rv]
  have hvLP : AL.valuation (evalOn' ψ b P)
      = AL.valuation (ψ (P.coeff i)) * AL.valuation b ^ i := by
    rw [← rvVal_rv (A := AL), hLP, map_mul, map_pow, rvVal_rv, rvVal_rv]
  have hvLQ : AL.valuation (evalOn' ψ b Q)
      = AL.valuation (ψ (Q.coeff j)) * AL.valuation b ^ j := by
    rw [← rvVal_rv (A := AL), hLQ, map_mul, map_pow, rvVal_rv, rvVal_rv]
  rw [hvKP, hvKQ, hvLP, hvLQ]
  exact valuation_monomial_le_iff_of_ramified hmono (hPC i) (hQC j)
    (lt_of_le_of_lt (Polynomial.le_natDegree_of_mem_supp i hi) hP)
    (lt_of_le_of_lt (Polynomial.le_natDegree_of_mem_supp j hj) hQ)

/-- **The leading term of any polynomial below the ramification order is that of a monomial**, on
both sides at once. -/
theorem exists_monomial_of_ramified (ha : a ≠ 0)
    (hord : ∀ k, 0 < k → k < n → AK.valuation a ^ k ∉ AK.valuation '' (φ.fieldRange : Set K))
    {P : R[X]} (hPn : P.natDegree < n) (hPC : ∀ i, P.coeff i ∈ C) :
    ∃ (c : R) (i : ℕ), rv (A := AK) (evalOn φ a P) = rv (A := AK) (φ c * a ^ i) ∧
      rv (A := AL) (evalOn' ψ b P) = rv (A := AL) (ψ c * b ^ i) := by
  by_cases hP0 : P = 0
  · subst hP0
    exact ⟨0, 0, by simp, by simp⟩
  obtain ⟨i, hi, hK, hL⟩ := exists_dominant_of_ramified hmono.dom ha hord hP0 hPn hPC
  exact ⟨P.coeff i, i, by rw [hK, map_mul, map_pow], by rw [hL, map_mul, map_pow]⟩

end Bounded

/-! ### The three reflection properties, for all degrees

The two shapes the ramified case comes in. In infinite order there is no bound to respect, so
each pair of polynomials is handled at its own degree; in finite order every polynomial is first
reduced modulo the monic polynomial that both `a` and `b` satisfy. -/

/-- The conclusion both shapes deliver: the kernel condition together with the two reflection
properties, for **every** polynomial. -/
structure RamifiedReflectAll (φ : R →+* K) (ψ : R →+* L) (AK : ValuationSubring K)
    (AL : ValuationSubring L) (a : K) (b : L) : Prop extends ReflectData φ ψ AK AL a b where
  /-- Every value of `R[a]` is the value of a monomial, matched on the far side. This is what
  the bookkeeping of the value group runs on: no value of `R[a]` is new beyond the values of `R`
  and the multiples of the value of `a`. It is the one thing the ramified case knows that the
  other two do not, and `ReflectData` carries everything else. -/
  monomial : ∀ P : R[X], ∃ (c : R) (i : ℕ),
    rv (A := AK) (evalOn φ a P) = rv (A := AK) (φ c * a ^ i) ∧
      rv (A := AL) (evalOn' ψ b P) = rv (A := AL) (ψ c * b ^ i)

/-- **The ramified case of infinite order.** -/
theorem ramifiedReflectAll_of_infinite (hmono : RamifiedMono φ ψ AK AL a b)
    (ha : a ≠ 0) (hb : b ≠ 0)
    (hord : ∀ k, 0 < k → AK.valuation a ^ k ∉ AK.valuation '' (φ.fieldRange : Set K)) :
    RamifiedReflectAll φ ψ AK AL a b := by
  refine ⟨⟨fun P Q => ?_⟩, fun P => ?_⟩
  · exact valuation_le_iff_of_ramified hmono.on ha hb (n := max P.natDegree Q.natDegree + 1)
      (fun k hk _ => hord k hk) (Nat.lt_succ_of_le (le_max_left _ _))
      (Nat.lt_succ_of_le (le_max_right _ _)) (fun _ => Set.mem_univ _) (fun _ => Set.mem_univ _)
  · exact exists_monomial_of_ramified hmono.on ha (n := P.natDegree + 1)
      (fun k hk _ => hord k hk) (Nat.lt_succ_self _) (fun _ => Set.mem_univ _)

/-- **The ramified case of finite order.** `P₀` is the monic polynomial — in Rideau-Kikuchi's proof
`Xⁿ - c` — that `a` satisfies over the coefficient field and whose image `b` satisfies. -/
theorem ramifiedReflectAll_of_modByMonic (hmono : RamifiedMono φ ψ AK AL a b)
    (ha : a ≠ 0) (hb : b ≠ 0) (hn : 0 < n)
    (hord : ∀ k, 0 < k → k < n → AK.valuation a ^ k ∉ AK.valuation '' (φ.fieldRange : Set K))
    {P₀ : R[X]} (hP₀ : P₀.Monic) (hP₀n : P₀.natDegree ≤ n)
    (hPa : evalOn φ a P₀ = 0) (hPb : evalOn' ψ b P₀ = 0) :
    RamifiedReflectAll φ ψ AK AL a b := by
  have hredK : ∀ S : R[X], evalOn φ a S = evalOn φ a (S %ₘ P₀) := by
    intro S
    conv_lhs => rw [← Polynomial.modByMonic_add_div S P₀]
    rw [map_add, map_mul, hPa, zero_mul, add_zero]
  have hredL : ∀ S : R[X], evalOn' ψ b S = evalOn' ψ b (S %ₘ P₀) := by
    intro S
    conv_lhs => rw [← Polynomial.modByMonic_add_div S P₀]
    rw [map_add, map_mul, hPb, zero_mul, add_zero]
  have hdeg : ∀ S : R[X], (S %ₘ P₀).natDegree < n := by
    intro S
    by_cases h0 : S %ₘ P₀ = 0
    · rw [h0, Polynomial.natDegree_zero]
      exact hn
    · exact lt_of_lt_of_le
        (Polynomial.natDegree_lt_natDegree h0 (Polynomial.degree_modByMonic_lt S hP₀)) hP₀n
  refine ⟨⟨fun P Q => ?_⟩, fun P => ?_⟩
  · rw [hredK P, hredK Q, hredL P, hredL Q]
    exact valuation_le_iff_of_ramified hmono.on ha hb hord (hdeg P) (hdeg Q)
      (fun _ => Set.mem_univ _) (fun _ => Set.mem_univ _)
  · rw [hredK P, hredL P]
    exact exists_monomial_of_ramified hmono.on ha hord (hdeg P) (fun _ => Set.mem_univ _)

end RamifiedReflect

section Ramified

variable {R : Type*} [Field R] {φ : R →+* K} {ψ : R →+* L} {fRV : AK.RV →*₀ AL.RV}

/-- **Proposition 2.1.3(3), transfer step (purely ramified).** If `val a` has order at least `n`
over the values of the coefficient field, then for polynomials of degree `< n` a single term
dominates, so the leading term of `Q a` is determined by those of the coefficients and of `a`.

This is `exists_dominant_of_ramified` — the same index dominates on both sides — followed by
`hcompat` and `hab`; only the one-directional domination is needed, which is `RamifiedDom` at the
whole coefficient field. -/
theorem rv_eval_eq_of_ramified_transfer {a : K} {b : L} {n : ℕ}
    (hcompat : ∀ r : R, fRV (rv (A := AK) (φ r)) = rv (A := AL) (ψ r))
    (hmono : ∀ (r r' : R) (i i' : ℕ),
      AK.valuation (φ r * a ^ i) < AK.valuation (φ r' * a ^ i') →
      AL.valuation (ψ r * b ^ i) < AL.valuation (ψ r' * b ^ i'))
    (hab : fRV (rv (A := AK) a) = rv (A := AL) b) (ha : a ≠ 0)
    (hord : ∀ k, 0 < k → k < n →
      AK.valuation a ^ k ∉ AK.valuation '' (φ.fieldRange : Set K)) :
    ∀ Q : R[X], Q.natDegree < n →
      fRV (rv (A := AK) (evalOn φ a Q)) = rv (A := AL) (evalOn' ψ b Q) := by
  have htr : RamifiedDom (Set.univ : Set R) n φ ψ AK AL a b := by
    intro r _ r' _ i _ i' _ h
    have h' : AK.valuation (φ r * a ^ i) < AK.valuation (φ r' * a ^ i') := by
      rw [map_mul, map_mul, map_pow, map_pow]; exact h
    have h'' := hmono r r' i i' h'
    rwa [map_mul, map_mul, map_pow, map_pow] at h''
  intro Q hQn
  by_cases hQ : Q = 0
  · simp [hQ]
  obtain ⟨i₀, -, hK, hL⟩ :=
    exists_dominant_of_ramified htr ha hord hQ hQn fun _ => Set.mem_univ _
  rw [hK, hL, map_mul, map_pow fRV, hab, hcompat]

/-- **Proposition 2.1.3(3).** The purely ramified case in full: if `a` is an `n`-th root of `c`
whose valuation has order at least `n` over the values of the coefficient field, and `b` is an
`n`-th root of the image of `c`, then `a` and `b` have the same leading-term type, so the embedding
extends by `extend` and preserves leading terms by `rv_extend`.

This is what step `v(K(C)) = Γ(C)` of Proposition 2.1.10 applies in order to lift a value: one
`n`-th root on each side. -/
theorem rvTypeEq_of_ramified {a : K} {b : L} {c : R} {n : ℕ} (hn : 0 < n)
    (hcompat : ∀ r : R, fRV (rv (A := AK) (φ r)) = rv (A := AL) (ψ r))
    (hmono : ∀ (r r' : R) (i i' : ℕ),
      AK.valuation (φ r * a ^ i) < AK.valuation (φ r' * a ^ i') →
      AL.valuation (ψ r * b ^ i) < AL.valuation (ψ r' * b ^ i'))
    (hab : fRV (rv (A := AK) a) = rv (A := AL) b) (ha : a ≠ 0)
    (hord : ∀ k, 0 < k → k < n →
      AK.valuation a ^ k ∉ AK.valuation '' (φ.fieldRange : Set K))
    (hca : a ^ n = φ c) (hcb : b ^ n = ψ c) :
    RvTypeEq fRV φ ψ a b := by
  refine rvTypeEq_of_modByMonic (P := X ^ n - C c) (Polynomial.monic_X_pow_sub_C c hn.ne')
    ?_ ?_ ?_
  · simp [hca]
  · simp [hcb]
  · intro Q hQ
    exact rv_eval_eq_of_ramified_transfer hcompat hmono hab ha hord Q
      (by rwa [Polynomial.natDegree_X_pow_sub_C] at hQ)

end Ramified

end ValuationSubring
