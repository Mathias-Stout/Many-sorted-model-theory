module

public import MultisortedLogic.Algebra.ACVF.Substructure.FieldLike
public import MultisortedLogic.Algebra.ACVF.Theory.Recovery

/-!
# Embedding data on a subring, and its fraction field

`Algebra/ACVF/Substructure/FieldLike.lean` reduces an `L_RV`-embedding of a *field-like*
substructure to purely algebraic data on the field sort: a ring homomorphism of the subfield which
reflects equality of leading terms and the order of their values (`FieldEmbeddingData`). This file
makes the same data available on a **subring**, and closes it under division.

Why a subring. The steps that enlarge a field-like substructure adjoin one element `a` to a
subfield `F`, and what they construct first is a homomorphism of the *ring* `F[a]`. Asking for a
subfield at that point would force a fraction-field argument into every case. Instead
`RingEmbeddingData` carries exactly the two reflection properties on a subring, and
`RingEmbeddingData.toFieldEmbeddingData` performs the division closure once and for all: the two
properties pass to quotients by cross-multiplication, because `rv` and `v` are multiplicative.

Both the `Γ`-part step of `RVLift` (`Algebra/ACVF/RVLift/GammaPart.lean`) and `FieldStep`
(`Algebra/ACVF/FieldStep/ReflectData.lean`) use it: each produces a subring of the field sort with
these two properties, and hands it to this file.

## Main definitions

* `Language.RingEmbeddingData` : the two reflection properties, on a subring.
* `Language.divField` : the subfield of quotients of a subring of the field sort.
* `Language.RingEmbeddingData.divHom`, `Language.RingEmbeddingData.toFieldEmbeddingData`.
-/

@[expose] public section

namespace ManySorted.Language

open Arity Structure ValuationSubring

universe w

variable {M : RVSort → Type w} [rvLang.Structure M] [M ⊨ ACVFTheory]
variable {N : RVSort → Type w} [rvLang.Structure N] [N ⊨ ACVFTheory]

/-! ### Embedding data on a subring -/

/-- **Algebraic data for an embedding, on a subring of the field sort**: a ring homomorphism into
the field sort of the target which reflects equality of leading terms and the order of their
values. This is `FieldEmbeddingData` with the subfield weakened to a subring, which is what the
enlargement steps produce before the fraction field is taken. -/
structure RingEmbeddingData (T : Subring (M RVSort.K)) (N : RVSort → Type w)
    [rvLang.Structure N] [N ⊨ ACVFTheory] where
  /-- The ring homomorphism on the field sort. -/
  hom : T →+* N RVSort.K
  /-- It reflects equality of leading terms. -/
  rv_iff : ∀ x y : T,
    (rvMap (x : M RVSort.K) = rvMap (y : M RVSort.K) ↔ rvMap (hom x) = rvMap (hom y))
  /-- It reflects the order of values. -/
  val_iff : ∀ x y : T,
    (valMap (rvMap (x : M RVSort.K)) ≤ valMap (rvMap (y : M RVSort.K))
      ↔ valMap (rvMap (hom x)) ≤ valMap (rvMap (hom y)))

namespace RingEmbeddingData

variable {T : Subring (M RVSort.K)} (d : RingEmbeddingData T N)

theorem eq_zero_iff (x : T) : (x : M RVSort.K) = 0 ↔ d.hom x = 0 := by
  have h := d.rv_iff x 0
  rw [show ((0 : T) : M RVSort.K) = 0 from rfl, map_zero,
    show rvMap (0 : M RVSort.K) = 0 from model_rv_eq_zero_iff.mpr rfl,
    show rvMap (0 : N RVSort.K) = 0 from model_rv_eq_zero_iff.mpr rfl,
    model_rv_eq_zero_iff, model_rv_eq_zero_iff] at h
  exact h

theorem hom_injective : Function.Injective d.hom := by
  intro x y h
  have hz := (d.eq_zero_iff (x - y)).mpr (by rw [map_sub, h, sub_self])
  rw [show ((x - y : T) : M RVSort.K) = (x : M RVSort.K) - (y : M RVSort.K) by push_cast; ring,
    sub_eq_zero] at hz
  exact Subtype.ext hz

end RingEmbeddingData

/-! ### The subfield of quotients of a subring -/

/-- The fraction field of a subring of the field sort, mapped into the field sort. Its range is
the subfield generated by the subring. -/
noncomputable def divIncl (T : Subring (M RVSort.K)) : FractionRing T →+* M RVSort.K :=
  IsFractionRing.lift (g := T.subtype) Subtype.val_injective

theorem divIncl_injective (T : Subring (M RVSort.K)) : Function.Injective (divIncl T) :=
  (divIncl T).injective

@[simp]
theorem divIncl_algebraMap (T : Subring (M RVSort.K)) (x : T) :
    divIncl T (algebraMap _ _ x) = (x : M RVSort.K) :=
  IsFractionRing.lift_algebraMap _ _

theorem mem_divIncl_range_iff {T : Subring (M RVSort.K)} {x : M RVSort.K} :
    x ∈ (divIncl T).range ↔ ∃ y ∈ T, ∃ z ∈ T, y / z = x := by
  constructor
  · rintro ⟨t, rfl⟩
    obtain ⟨y, z, -, rfl⟩ := IsFractionRing.div_surjective (A := T) t
    exact ⟨y.1, y.2, z.1, z.2, by rw [map_div₀, divIncl_algebraMap, divIncl_algebraMap]⟩
  · rintro ⟨y, hy, z, hz, rfl⟩
    refine ⟨algebraMap T _ ⟨y, hy⟩ / algebraMap T _ ⟨z, hz⟩, ?_⟩
    rw [map_div₀, divIncl_algebraMap, divIncl_algebraMap]

theorem inv_mem_divIncl_range {T : Subring (M RVSort.K)} {x : M RVSort.K}
    (hx : x ∈ (divIncl T).range) : x⁻¹ ∈ (divIncl T).range := by
  obtain ⟨y, hy, z, hz, rfl⟩ := mem_divIncl_range_iff.mp hx
  exact mem_divIncl_range_iff.mpr ⟨z, hz, y, hy, (inv_div y z).symm⟩

/-- **The subfield of quotients of a subring of the field sort.** -/
noncomputable def divField (T : Subring (M RVSort.K)) : Subfield (M RVSort.K) :=
  Subring.toSubfield (divIncl T).range (fun _ hx => inv_mem_divIncl_range hx)

theorem mem_divField_iff {T : Subring (M RVSort.K)} {x : M RVSort.K} :
    x ∈ divField T ↔ ∃ y ∈ T, ∃ z ∈ T, z ≠ 0 ∧ y / z = x := by
  constructor
  · intro hx
    obtain ⟨y, hy, z, hz, rfl⟩ := mem_divIncl_range_iff.mp hx
    by_cases hz0 : z = 0
    · exact ⟨0, T.zero_mem, 1, T.one_mem, one_ne_zero, by rw [hz0, div_zero, zero_div]⟩
    · exact ⟨y, hy, z, hz, hz0, rfl⟩
  · rintro ⟨y, hy, z, hz, -, rfl⟩
    exact mem_divIncl_range_iff.mpr ⟨y, hy, z, hz, rfl⟩

theorem subset_divField (T : Subring (M RVSort.K)) : ∀ x ∈ T, x ∈ divField T := fun x hx =>
  mem_divField_iff.mpr ⟨x, hx, 1, T.one_mem, one_ne_zero, div_one x⟩

/-! ### Canceling a factor

Both reflection properties are stable under multiplication by a nonzero element of the field
sort, and that is all that is needed to pass them from a subring to its quotients: a quotient is
turned into an element of the subring by clearing denominators. -/

theorem model_rv_mul_right_cancel_iff {x y w : M RVSort.K} (hw : w ≠ 0) :
    rvMap (x * w) = rvMap (y * w) ↔ rvMap x = rvMap y := by
  rw [rvMap_eq_iff_rv_eq, rvMap_eq_iff_rv_eq, map_mul, map_mul]
  exact ⟨fun h => mul_right_cancel₀ (by rwa [ne_eq, rv_eq_zero_iff]) h, fun h => by rw [h]⟩

theorem model_val_mul_right_cancel_le_iff {x y w : M RVSort.K} (hw : w ≠ 0) :
    valMap (rvMap (x * w)) ≤ valMap (rvMap (y * w)) ↔ valMap (rvMap x) ≤ valMap (rvMap y) := by
  rw [valMap_le_iff_valuation, valMap_le_iff_valuation, map_mul, map_mul]
  exact mul_le_mul_iff_left₀ (pos_iff_ne_zero.mpr ((Valuation.ne_zero_iff _).mpr hw))

/-! ### The extension to the subfield of quotients -/

namespace RingEmbeddingData

variable {T : Subring (M RVSort.K)} (d : RingEmbeddingData T N)

/-- The homomorphism of a subring, extended to the subfield of its quotients. -/
noncomputable def divHom : divField T →+* N RVSort.K where
  toFun x := rangeLift (divIncl_injective T) (IsFractionRing.lift d.hom_injective) ⟨x.1, x.2⟩
  map_one' := map_one _
  map_zero' := map_zero _
  map_add' x y := by
    rw [← map_add]
    exact congrArg _ (Subtype.ext rfl)
  map_mul' x y := by
    rw [← map_mul]
    exact congrArg _ (Subtype.ext rfl)

/-- The extension, computed on a quotient. -/
theorem divHom_eq {y z : M RVSort.K} (hy : y ∈ T) (hz : z ∈ T) {x : divField T}
    (h : y / z = (x : M RVSort.K)) :
    d.divHom x = d.hom ⟨y, hy⟩ / d.hom ⟨z, hz⟩ := by
  change rangeLift (divIncl_injective T) (IsFractionRing.lift d.hom_injective) ⟨x.1, x.2⟩ = _
  rw [rangeLift_eq (divIncl_injective T) _
      (a := algebraMap T (FractionRing T) ⟨y, hy⟩ / algebraMap T (FractionRing T) ⟨z, hz⟩)
      (by rw [map_div₀, divIncl_algebraMap, divIncl_algebraMap]; exact h),
    map_div₀, IsFractionRing.lift_algebraMap, IsFractionRing.lift_algebraMap]

/-- Multiplicativity of the underlying homomorphism, in the form the clearing of denominators
uses it. -/
theorem hom_mul_mem {a b : M RVSort.K} (ha : a ∈ T) (hb : b ∈ T) :
    d.hom ⟨a * b, T.mul_mem ha hb⟩ = d.hom ⟨a, ha⟩ * d.hom ⟨b, hb⟩ := by
  rw [← map_mul]
  exact congrArg d.hom (Subtype.ext rfl)

theorem hom_ne_zero {a : M RVSort.K} (ha : a ∈ T) (ha0 : a ≠ 0) : d.hom ⟨a, ha⟩ ≠ 0 :=
  fun h => ha0 ((d.eq_zero_iff ⟨a, ha⟩).mpr h)

/-- The extension really extends. -/
theorem divHom_apply_of_mem {x : M RVSort.K} (hx : x ∈ T) (hx' : x ∈ divField T) :
    d.divHom ⟨x, hx'⟩ = d.hom ⟨x, hx⟩ := by
  have h1 : d.hom ⟨1, T.one_mem⟩ = 1 := map_one d.hom
  rw [d.divHom_eq hx T.one_mem (x := ⟨x, hx'⟩) (div_one x), h1, div_one]

section Quotients

variable {x y : divField T}

/-- Clearing denominators: a quotient times the product of the two denominators lies in the
subring, on both sides of the homomorphism at once. -/
private theorem clear_denom {y₁ z₁ : M RVSort.K} (hy₁ : y₁ ∈ T) (hz₁ : z₁ ∈ T) (hz₁0 : z₁ ≠ 0)
    (hx : y₁ / z₁ = (x : M RVSort.K)) {z₂ : M RVSort.K} (hz₂ : z₂ ∈ T) (hz₂0 : z₂ ≠ 0) :
    (x : M RVSort.K) * (z₁ * z₂) = y₁ * z₂ ∧
      d.divHom x * (d.hom ⟨z₁, hz₁⟩ * d.hom ⟨z₂, hz₂⟩)
        = d.hom ⟨y₁ * z₂, T.mul_mem hy₁ hz₂⟩ := by
  refine ⟨by rw [← hx]; field_simp, ?_⟩
  rw [d.divHom_eq hy₁ hz₁ hx, d.hom_mul_mem hy₁ hz₂, div_mul_eq_mul_div, mul_comm _ (d.hom _),
    ← mul_assoc, mul_div_assoc, div_self (d.hom_ne_zero hz₁ hz₁0), mul_one, mul_comm]

/-- **The reflection of leading terms passes to quotients.** -/
theorem divHom_rv_iff (x y : divField T) :
    rvMap (x : M RVSort.K) = rvMap (y : M RVSort.K)
      ↔ rvMap (d.divHom x) = rvMap (d.divHom y) := by
  obtain ⟨y₁, hy₁, z₁, hz₁, hz₁0, hx⟩ := mem_divField_iff.mp x.2
  obtain ⟨y₂, hy₂, z₂, hz₂, hz₂0, hy⟩ := mem_divField_iff.mp y.2
  obtain ⟨hxM, hxN⟩ := d.clear_denom hy₁ hz₁ hz₁0 hx hz₂ hz₂0
  obtain ⟨hyM, hyN⟩ := d.clear_denom hy₂ hz₂ hz₂0 hy hz₁ hz₁0
  rw [← model_rv_mul_right_cancel_iff (x := (x : M RVSort.K)) (y := (y : M RVSort.K))
      (mul_ne_zero hz₁0 hz₂0),
    ← model_rv_mul_right_cancel_iff (x := d.divHom x) (y := d.divHom y)
      (mul_ne_zero (d.hom_ne_zero hz₁ hz₁0) (d.hom_ne_zero hz₂ hz₂0)),
    hxM, hxN]
  rw [show (y : M RVSort.K) * (z₁ * z₂) = y * (z₂ * z₁) by ring, hyM]
  rw [show d.divHom y * (d.hom ⟨z₁, hz₁⟩ * d.hom ⟨z₂, hz₂⟩)
      = d.divHom y * (d.hom ⟨z₂, hz₂⟩ * d.hom ⟨z₁, hz₁⟩) by ring, hyN]
  exact d.rv_iff ⟨y₁ * z₂, T.mul_mem hy₁ hz₂⟩ ⟨y₂ * z₁, T.mul_mem hy₂ hz₁⟩

/-- **The reflection of the order of values passes to quotients.** -/
theorem divHom_val_iff (x y : divField T) :
    valMap (rvMap (x : M RVSort.K)) ≤ valMap (rvMap (y : M RVSort.K))
      ↔ valMap (rvMap (d.divHom x)) ≤ valMap (rvMap (d.divHom y)) := by
  obtain ⟨y₁, hy₁, z₁, hz₁, hz₁0, hx⟩ := mem_divField_iff.mp x.2
  obtain ⟨y₂, hy₂, z₂, hz₂, hz₂0, hy⟩ := mem_divField_iff.mp y.2
  obtain ⟨hxM, hxN⟩ := d.clear_denom hy₁ hz₁ hz₁0 hx hz₂ hz₂0
  obtain ⟨hyM, hyN⟩ := d.clear_denom hy₂ hz₂ hz₂0 hy hz₁ hz₁0
  rw [← model_val_mul_right_cancel_le_iff (x := (x : M RVSort.K)) (y := (y : M RVSort.K))
      (mul_ne_zero hz₁0 hz₂0),
    ← model_val_mul_right_cancel_le_iff (x := d.divHom x) (y := d.divHom y)
      (mul_ne_zero (d.hom_ne_zero hz₁ hz₁0) (d.hom_ne_zero hz₂ hz₂0)),
    hxM, hxN]
  rw [show (y : M RVSort.K) * (z₁ * z₂) = y * (z₂ * z₁) by ring, hyM]
  rw [show d.divHom y * (d.hom ⟨z₁, hz₁⟩ * d.hom ⟨z₂, hz₂⟩)
      = d.divHom y * (d.hom ⟨z₂, hz₂⟩ * d.hom ⟨z₁, hz₁⟩) by ring, hyN]
  exact d.val_iff ⟨y₁ * z₂, T.mul_mem hy₁ hz₂⟩ ⟨y₂ * z₁, T.mul_mem hy₂ hz₁⟩

end Quotients

/-- **The fraction-field closure of embedding data on a subring.** The two reflection properties
pass to quotients, so a subring with them determines an embedding of the field-like substructure
attached to the subfield of its quotients. -/
noncomputable def toFieldEmbeddingData : FieldEmbeddingData (divField T) N where
  hom := d.divHom
  rv_iff := d.divHom_rv_iff
  val_iff := d.divHom_val_iff

@[simp]
theorem toFieldEmbeddingData_hom_of_mem {x : M RVSort.K} (hx : x ∈ T)
    (hx' : x ∈ divField T) :
    d.toFieldEmbeddingData.hom ⟨x, hx'⟩ = d.hom ⟨x, hx⟩ :=
  d.divHom_apply_of_mem hx hx'

end RingEmbeddingData

end ManySorted.Language
