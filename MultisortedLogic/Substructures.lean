/-!
# Substructures

A substructure of an `L`-structure `M` is a family of sets `A s ⊆ M s`, one for each sort, closed
under the function symbols. A substructure coerces to its family of sets, `⇑A : ∀ s, Set (M s)`:
`x ∈ A s` says that `x : M s` lies in `A`, and whatever is stated for a family of sets applies to a
substructure. The induced structure lives on `fun s => ↥(A s)`.

## Main definitions

* `Language.Substructure L M`, a complete lattice.
* `Substructure.closure L X`: the substructure generated by a family of sets `X`.
* `Substructure.comap`, `Substructure.map`: preimages and images along homomorphisms.
* `Substructure.inducedStructure`: the `L`-structure on `fun s => ↥(A s)`, with the inclusion
  `Substructure.subtype` as an embedding.
* `Hom.range`, `Hom.domRestrict`, `Hom.codRestrict`, `Embedding.equivRange` and
  `Substructure.inclusion`.

## Main results

* `Substructure.mem_closure_iff_exists_term`: the elements of `closure L X` are the values of terms
  at tuples from `X`.

## Implementation notes

Where Mathlib uses sets, substructures here are families of sets. Mathlib's cardinality bounds on
closures are not included.

## References

This file was originally based on `Mathlib/ModelTheory/Substructures.lean`, by Aaron Anderson and
Gabin Kolly.
-/

@[expose] public section

universe u v w w' w'' z

namespace ManySorted

open Arity

/-- A tuple whose entries each lie in a member of a directed family of families of sets lies
entirely in one member. -/
theorem Arity.Interpret.exists_forall_mem_of_directed {S : Type z} {M : S → Type w} {ι : Type*}
    [Nonempty ι] {X : ι → ∀ s, Set (M s)} (hX : Directed (· ≤ ·) X) :
    ∀ {σ : Arity S} {x : M [^] σ}, (∀ s k, ∃ i, x.get s k ∈ X i s) → ∃ i, ∀ s k, x.get s k ∈ X i s
  | .nil, _, _ => ⟨Classical.arbitrary ι, fun _ k => nomatch k⟩
  | .of _, _, h =>
    let ⟨i, hi⟩ := h _ .var
    ⟨i, fun _ k => by cases k; exact hi⟩
  | .prod _ _, x, h => by
    obtain ⟨i₁, h₁⟩ := exists_forall_mem_of_directed hX (x := x.1) fun s k => h s (.left k)
    obtain ⟨i₂, h₂⟩ := exists_forall_mem_of_directed hX (x := x.2) fun s k => h s (.right k)
    obtain ⟨i, hi₁, hi₂⟩ := hX i₁ i₂
    refine ⟨i, fun s k => ?_⟩
    cases k with
    | left k => exact hi₁ s (h₁ s k)
    | right k => exact hi₂ s (h₂ s k)

namespace Language

open Structure

variable {S : Type z} {L : Language.{u, v} S} {M : S → Type w} {N : S → Type w'}
  {P : S → Type w''} [L.Structure M] [L.Structure N] [L.Structure P]

/-! ### Closure under a function symbol -/

section ClosedUnder

variable {σ : Arity S} {t : S} (f : L.Functions σ t) (X : ∀ s, Set (M s))

/-- `X` is closed under the function symbol `f`: it contains `f x` for every tuple `x` with entries
in `X`. -/
def ClosedUnder : Prop :=
  ∀ x : M [^] σ, (∀ s i, x.get s i ∈ X s) → funMap f x ∈ X t

variable (L) in
@[simp]
theorem closedUnder_univ : ClosedUnder (M := M) f fun _ => Set.univ :=
  fun _ _ => Set.mem_univ _

variable {f X} {Y : ∀ s, Set (M s)}

theorem ClosedUnder.inf (hX : ClosedUnder f X) (hY : ClosedUnder f Y) : ClosedUnder f (X ⊓ Y) :=
  fun x h => ⟨hX x fun s i => (h s i).1, hY x fun s i => (h s i).2⟩

theorem ClosedUnder.sInf {𝒳 : Set (∀ s, Set (M s))} (h𝒳 : ∀ X ∈ 𝒳, ClosedUnder f X) :
    ClosedUnder f (sInf 𝒳) := by
  intro x hx
  simp only [sInf_apply, Set.iInf_eq_iInter, Set.mem_iInter, Subtype.forall] at hx ⊢
  exact fun X hX => h𝒳 X hX x fun s i => hx s i X hX

end ClosedUnder

/-! ### Substructures -/

variable (L M) in
/-- A substructure of `M`: a family of sets, one for each sort, closed under the function
symbols. -/
structure Substructure where
  /-- The elements of each sort. -/
  carrier : ∀ s, Set (M s)
  /-- The elements are closed under the function symbols. -/
  fun_mem : ∀ {σ : Arity S} {t : S} (f : L.Functions σ t), ClosedUnder f carrier

namespace Substructure

instance : DFunLike (L.Substructure M) S fun s => Set (M s) where
  coe := carrier
  coe_injective A B h := by cases A; cases B; congr

/-- See Note [custom simps projection]. -/
def Simps.coe (A : L.Substructure M) : ∀ s, Set (M s) :=
  A

initialize_simps_projections Substructure (carrier → coe, as_prefix coe)

variable {A B : L.Substructure M} {s : S}

@[simp]
theorem mem_carrier {x : M s} : x ∈ A.carrier s ↔ x ∈ A s :=
  Iff.rfl

@[simp]
theorem coe_mk (X : ∀ s, Set (M s)) (h : ∀ {σ : Arity S} {t : S} (f : L.Functions σ t),
    ClosedUnder f X) : ⇑(⟨X, h⟩ : L.Substructure M) = X :=
  rfl

/-- Two substructures are equal if they have the same elements. -/
@[ext]
theorem ext (h : ∀ s (x : M s), x ∈ A s ↔ x ∈ B s) : A = B :=
  DFunLike.coe_injective (funext fun s => Set.ext (h s))

/-- Copy a substructure replacing its family of sets with an equal one. -/
protected def copy (A : L.Substructure M) (X : ∀ s, Set (M s)) (hX : X = ⇑A) :
    L.Substructure M where
  carrier := X
  fun_mem f := hX ▸ A.fun_mem f

@[simp]
theorem coe_copy (X : ∀ s, Set (M s)) (hX : X = ⇑A) : ⇑(A.copy X hX) = X :=
  rfl

theorem copy_eq (X : ∀ s, Set (M s)) (hX : X = ⇑A) : A.copy X hX = A :=
  DFunLike.coe_injective hX

theorem constants_mem (A : L.Substructure M) (c : L.Constants s) :
    funMap c PUnit.unit ∈ A s :=
  A.fun_mem c _ fun _ i => nomatch i

/-! ### The complete lattice of substructures -/

instance : PartialOrder (L.Substructure M) :=
  PartialOrder.lift _ DFunLike.coe_injective

theorem le_def : A ≤ B ↔ ∀ s, A s ⊆ B s :=
  Iff.rfl

@[simp, norm_cast]
theorem coe_le_coe : ⇑A ≤ ⇑B ↔ A ≤ B :=
  Iff.rfl

instance : Top (L.Substructure M) :=
  ⟨{ carrier := fun _ => Set.univ
     fun_mem := fun _ _ _ => Set.mem_univ _ }⟩

instance : Inhabited (L.Substructure M) :=
  ⟨⊤⟩

theorem mem_top (x : M s) : x ∈ (⊤ : L.Substructure M) s :=
  Set.mem_univ x

@[simp]
theorem coe_top : ⇑(⊤ : L.Substructure M) = fun _ => Set.univ :=
  rfl

instance : Min (L.Substructure M) :=
  ⟨fun A B =>
    { carrier := ⇑A ⊓ ⇑B
      fun_mem := fun f => (A.fun_mem f).inf (B.fun_mem f) }⟩

@[simp]
theorem coe_inf (A B : L.Substructure M) : ⇑(A ⊓ B) = ⇑A ⊓ ⇑B :=
  rfl

theorem mem_inf {x : M s} : x ∈ (A ⊓ B) s ↔ x ∈ A s ∧ x ∈ B s :=
  Iff.rfl

instance : InfSet (L.Substructure M) :=
  ⟨fun 𝒜 =>
    { carrier := sInf ((⇑) '' 𝒜)
      fun_mem := fun f => ClosedUnder.sInf fun _ ⟨A, _, hA⟩ => hA ▸ A.fun_mem f }⟩

@[simp]
theorem coe_sInf (𝒜 : Set (L.Substructure M)) : ⇑(sInf 𝒜) = sInf ((⇑) '' 𝒜) :=
  rfl

theorem mem_sInf {𝒜 : Set (L.Substructure M)} {x : M s} : x ∈ sInf 𝒜 s ↔ ∀ A ∈ 𝒜, x ∈ A s := by
  simp [sInf_apply]

theorem mem_iInf {ι : Sort*} {A : ι → L.Substructure M} {x : M s} :
    x ∈ (⨅ i, A i) s ↔ ∀ i, x ∈ A i s := by
  simp only [iInf, mem_sInf, Set.forall_mem_range]

@[simp]
theorem coe_iInf {ι : Sort*} {A : ι → L.Substructure M} : ⇑(⨅ i, A i) = ⨅ i, ⇑(A i) := by
  ext s x
  simp [mem_iInf, iInf_apply]

instance : CompleteLattice (L.Substructure M) :=
  { completeLatticeOfInf (L.Substructure M) fun _ =>
      IsGLB.of_image (fun {A B : L.Substructure M} => show ⇑A ≤ ⇑B ↔ A ≤ B from Iff.rfl)
        (isGLB_sInf _) with
    le := (· ≤ ·)
    lt := (· < ·)
    top := ⊤
    le_top := fun _ _ x _ => mem_top x
    inf := (· ⊓ ·)
    sInf := InfSet.sInf
    le_inf := fun _ _ _ hA hB s _ hx => ⟨hA s hx, hB s hx⟩
    inf_le_left := fun _ _ _ _ => And.left
    inf_le_right := fun _ _ _ _ => And.right }

/-! ### The substructure generated by a family of sets -/

variable (L) in
/-- The substructure generated by a family of sets `X`: the least substructure containing it. -/
def closure : LowerAdjoint ((⇑) : L.Substructure M → ∀ s, Set (M s)) :=
  ⟨fun X => sInf {A | X ≤ ⇑A}, fun X _ =>
    ⟨fun h s _ hx => h s (mem_sInf.2 fun _ (hA : X ≤ _) => hA s hx), fun h => sInf_le h⟩⟩

variable {X Y : ∀ s, Set (M s)}

theorem mem_closure {x : M s} : x ∈ closure L X s ↔ ∀ A : L.Substructure M, X ≤ ⇑A → x ∈ A s :=
  mem_sInf

/-- The substructure generated by a family of sets contains it. -/
@[simp]
theorem subset_closure : X s ⊆ closure L X s :=
  (closure L).le_closure X s

theorem notMem_of_notMem_closure {x : M s} (hx : x ∉ closure L X s) : x ∉ X s :=
  fun h => hx (subset_closure h)

/-- A substructure contains `closure L X` iff it contains `X`. -/
@[simp]
theorem closure_le : closure L X ≤ A ↔ X ≤ ⇑A :=
  (closure L).gc X A

@[gcongr]
theorem closure_mono (h : X ≤ Y) : closure L X ≤ closure L Y :=
  (closure L).monotone h

theorem closure_eq_of_le (h₁ : X ≤ ⇑A) (h₂ : A ≤ closure L X) : closure L X = A :=
  le_antisymm (closure_le.2 h₁) h₂

@[simp]
theorem closed (A : L.Substructure M) : ⇑A ∈ (closure L).closed :=
  congrArg DFunLike.coe (closure_eq_of_le le_rfl fun _ _ hx => subset_closure hx)

/-- **Induction on the generated substructure**: a property that holds on `X` and is preserved by
the function symbols holds on `closure L X`. -/
theorem closure_induction {p : ∀ s, M s → Prop} {x : M s} (h : x ∈ closure L X s)
    (Hs : ∀ s, ∀ x ∈ X s, p s x)
    (Hfun : ∀ {σ : Arity S} {t : S} (f : L.Functions σ t), ClosedUnder f fun s => {x | p s x}) :
    p s x :=
  (closure_le (A := ⟨fun s => {x | p s x}, Hfun⟩)).2 Hs s h

variable (L M) in
/-- `closure` forms a Galois insertion with the coercion to families of sets. -/
protected def gi : GaloisInsertion (closure L) ((⇑) : L.Substructure M → ∀ s, Set (M s)) where
  choice X _ := closure L X
  gc := (closure L).gc
  le_l_u _ _ _ hx := subset_closure hx
  choice_eq _ _ := rfl

/-- The closure of a substructure is the substructure itself. -/
@[simp]
theorem closure_eq (A : L.Substructure M) : closure L ⇑A = A :=
  (Substructure.gi L M).l_u_eq A

@[simp]
theorem closure_empty : closure L (⊥ : ∀ s, Set (M s)) = ⊥ :=
  (Substructure.gi L M).gc.l_bot

@[simp]
theorem closure_univ : closure L (⊤ : ∀ s, Set (M s)) = ⊤ :=
  closure_eq ⊤

theorem closure_union (X Y : ∀ s, Set (M s)) : closure L (X ⊔ Y) = closure L X ⊔ closure L Y :=
  (Substructure.gi L M).gc.l_sup

theorem closure_iUnion {ι : Sort*} (X : ι → ∀ s, Set (M s)) :
    closure L (⨆ i, X i) = ⨆ i, closure L (X i) :=
  (Substructure.gi L M).gc.l_iSup

theorem iSup_eq_closure {ι : Sort*} (A : ι → L.Substructure M) :
    ⨆ i, A i = closure L (⨆ i, ⇑(A i)) := by
  simp_rw [closure_iUnion, closure_eq]

/-- The union of a directed family of substructures is a substructure. -/
theorem mem_iSup_of_directed {ι : Type*} [Nonempty ι] {A : ι → L.Substructure M}
    (hA : Directed (· ≤ ·) A) {x : M s} : x ∈ (⨆ i, A i) s ↔ ∃ i, x ∈ A i s := by
  refine ⟨fun hx => ?_, fun ⟨i, hi⟩ => le_iSup A i s hi⟩
  let U : L.Substructure M :=
    { carrier := fun s => ⋃ i, A i s
      fun_mem := fun f x hx => by
        obtain ⟨i, hi⟩ := Interpret.exists_forall_mem_of_directed (X := fun i => ⇑(A i)) hA
          fun s k => Set.mem_iUnion.1 (hx s k)
        exact Set.mem_iUnion.2 ⟨i, (A i).fun_mem f x hi⟩ }
  exact Set.mem_iUnion.1 ((iSup_le fun i s _ hy => Set.mem_iUnion.2 ⟨i, hy⟩ : ⨆ i, A i ≤ U) s hx)

theorem mem_sSup_of_directedOn {𝒜 : Set (L.Substructure M)} (h𝒜 : 𝒜.Nonempty)
    (hdir : DirectedOn (· ≤ ·) 𝒜) {x : M s} : x ∈ sSup 𝒜 s ↔ ∃ A ∈ 𝒜, x ∈ A s := by
  have : Nonempty 𝒜 := h𝒜.to_subtype
  simp only [sSup_eq_iSup', mem_iSup_of_directed hdir.directed_val, Subtype.exists, exists_prop]

/-! ### The description by terms -/

/-- The values of a tuple of terms at a tuple from a substructure lie in the substructure. -/
theorem _root_.ManySorted.Language.Term.realize_mem (A : L.Substructure M) {Γ σ : Arity S}
    (t : L.Term Γ σ) {xs : M [^] Γ} (h : ∀ s i, xs.get s i ∈ A s) :
    ∀ s i, (t.realize xs).get s i ∈ A s := by
  induction t with
  | var j => intro s i; cases i; exact h _ j
  | func f ts ih => intro s i; cases i; exact A.fun_mem f _ ih
  | nil => intro s i; exact nomatch i
  | prod t₁ t₂ ih₁ ih₂ =>
    intro s i
    cases i with
    | left i => exact ih₁ s i
    | right i => exact ih₂ s i

/-- A tuple whose entries are values of terms at tuples from `X` is the value of a tuple of terms
at a tuple from `X`. -/
theorem exists_term_realize_eq : ∀ {σ : Arity S} {y : M [^] σ},
    (∀ s i, ∃ (Γ : Arity S) (xs : (fun s => ↥(X s)) [^] Γ) (t : L.Term Γ ⦃s⦄),
      t.realize (xs.map fun _ a => a.1) = y.get s i) →
    ∃ (Γ : Arity S) (xs : (fun s => ↥(X s)) [^] Γ) (t : L.Term Γ σ),
      t.realize (xs.map fun _ a => a.1) = y
  | .nil, _, _ => ⟨⦃⦄, PUnit.unit, .nil, rfl⟩
  | .of _, _, h => h _ .var
  | .prod _ _, y, h => by
    obtain ⟨Γ₁, xs₁, t₁, h₁⟩ := exists_term_realize_eq (y := y.1) fun s i => h s (.left i)
    obtain ⟨Γ₂, xs₂, t₂, h₂⟩ := exists_term_realize_eq (y := y.2) fun s i => h s (.right i)
    exact ⟨Γ₁ ⨯ Γ₂, (xs₁, xs₂), .prod (t₁.relabel fun _ => .left) (t₂.relabel fun _ => .right),
      by simp [h₁, h₂]⟩

/-- The elements of the substructure generated by `X` are the values of terms at tuples from
`X`. -/
theorem mem_closure_iff_exists_term {x : M s} :
    x ∈ closure L X s ↔ ∃ (Γ : Arity S) (xs : (fun s => ↥(X s)) [^] Γ) (t : L.Term Γ ⦃s⦄),
      t.realize (xs.map fun _ a => a.1) = x := by
  refine ⟨fun hx => ?_, fun ⟨Γ, xs, t, ht⟩ => ht ▸ t.realize_mem _ (fun s i => by
    rw [Interpret.get_map]
    exact subset_closure (xs.get s i).2) s .var⟩
  let T : L.Substructure M :=
    { carrier := fun s => {x | ∃ (Γ : Arity S) (xs : (fun s => ↥(X s)) [^] Γ)
        (t : L.Term Γ ⦃s⦄), t.realize (xs.map fun _ a => a.1) = x}
      fun_mem := fun f _ hy =>
        let ⟨Γ, xs, t, ht⟩ := exists_term_realize_eq hy
        ⟨Γ, xs, .func f t, by rw [Term.realize_func, ht]⟩ }
  exact (closure_le.2 (fun s x hx => ⟨⦃s⦄, ⟨x, hx⟩, .var .var, rfl⟩) : closure L X ≤ T) s hx

/-! ### The size of the substructure generated by a family of sets -/

section Cardinality

open Cardinal

variable (L X) in
/-- A tuple from `X` and a term whose value at the tuple is a given element of the substructure
generated by `X`. -/
noncomputable def closureTerm (x : Σ s, closure L X s) :
    Σ Γ : Arity S, ((fun s => ↥(X s)) [^] Γ) × L.Term Γ ⦃x.1⦄ :=
  let h := mem_closure_iff_exists_term.1 x.2.2
  ⟨h.choose, h.choose_spec.choose, h.choose_spec.choose_spec.choose⟩

theorem realize_closureTerm (x : Σ s, closure L X s) :
    (closureTerm L X x).2.2.realize ((closureTerm L X x).2.1.map fun _ a => a.1) = x.2.1 :=
  (mem_closure_iff_exists_term.1 x.2.2).choose_spec.choose_spec.choose_spec

variable (L X) in
/-- An element of the substructure generated by `X`, encoded by a tuple from `X` and a term whose
value at the tuple it is. -/
noncomputable def closureEncode (x : Σ s, closure L X s) :
    Arity (Σ s, X s) × Arity L.Label :=
  (Arity.Interpret.encode (closureTerm L X x).2.1, (closureTerm L X x).2.2.encode)

theorem closureEncode_injective : Function.Injective (closureEncode L X) := by
  rintro ⟨s, x, hx⟩ ⟨s', y, hy⟩ h
  have hx' := realize_closureTerm (L := L) (X := X) ⟨s, x, hx⟩
  have hy' := realize_closureTerm (L := L) (X := X) ⟨s', y, hy⟩
  simp only [closureEncode, Prod.mk.injEq] at h
  generalize closureTerm L X ⟨s, x, hx⟩ = p at h hx'
  generalize closureTerm L X ⟨s', y, hy⟩ = q at h hy'
  obtain ⟨Γ, xs, t⟩ := p
  obtain ⟨Γ', ys, t'⟩ := q
  obtain ⟨h₁, h₂⟩ := h
  obtain ⟨⟩ := Arity.Interpret.encode_injective (A := fun s => ↥(X s)) (a₁ := ⟨Γ, xs⟩)
    (a₂ := ⟨Γ', ys⟩) h₁
  obtain ⟨⟩ := Term.encode_injective (L := L) (a₁ := ⟨⦃s⦄, t⟩) (a₂ := ⟨⦃s'⦄, t'⟩) h₂
  obtain rfl := hx'.symm.trans hy'
  rfl

variable (L X) in
/-- **The size of a generated substructure** is at most `max ℵ₀ (#X + #S + L.card)`, with lifts. -/
theorem lift_card_sigma_closure_le :
    lift.{max u v} #(Σ s, closure L X s) ≤
      max ℵ₀ (lift.{max u v} #(Σ s, X s) + lift.{w} (lift.{max u v} #S + L.card)) := by
  have h₁ : lift.{max u v} #(Σ s, closure L X s) ≤
      lift.{max u v} #(Arity (Σ s, X s)) * lift.{w} #(Arity L.Label) := by
    rw [← mk_uLift, ← mk_uLift, ← mk_uLift, ← lift_id #(ULift.{max u v} (Arity (Σ s, X s))),
      ← lift_id #(ULift.{w} (Arity L.Label)), ← mk_prod]
    refine mk_le_of_injective (f := fun x => (ULift.up (closureEncode L X x.down).1,
      ULift.up (closureEncode L X x.down).2)) fun x y h => ?_
    simp only [Prod.mk.injEq, ULift.up_inj] at h
    exact ULift.down_injective (closureEncode_injective (Prod.ext h.1 h.2))
  have h₂ : lift.{max u v} #(Arity (Σ s, X s)) ≤ max ℵ₀ (lift.{max u v} #(Σ s, X s)) := by
    simpa using lift_le.2 (Arity.card_le (Σ s, X s))
  have h₃ : lift.{w} #(Arity L.Label) ≤ max ℵ₀ (lift.{w} (lift.{max u v} #S + L.card)) := by
    simpa using lift_le.2 ((Arity.card_le L.Label).trans (max_le (le_max_left _ _)
      (card_label_le L)))
  refine h₁.trans <| (mul_le_mul' h₂ h₃).trans ?_
  rw [mul_eq_max (le_max_left _ _) (le_max_left _ _)]
  exact max_le (max_le_max le_rfl (self_le_add_right _ _))
    (max_le_max le_rfl (self_le_add_left _ _))

end Cardinality

/-! ### Preimages and images -/

/-- The preimage of a substructure along a homomorphism. -/
@[simps]
def comap (φ : M →[L] N) (B : L.Substructure N) : L.Substructure M where
  carrier s := φ s ⁻¹' B s
  fun_mem f x hx := by
    simp only [Set.mem_preimage, Hom.map_fun]
    exact B.fun_mem f _ fun s i => by rw [Interpret.get_map]; exact hx s i

theorem mem_comap {φ : M →[L] N} {B : L.Substructure N} {x : M s} :
    x ∈ B.comap φ s ↔ φ s x ∈ B s :=
  Iff.rfl

theorem comap_comap (C : L.Substructure P) (g : N →[L] P) (f : M →[L] N) :
    (C.comap g).comap f = C.comap (g.comp f) :=
  rfl

@[simp]
theorem comap_id (A : L.Substructure M) : A.comap (Hom.id L M) = A :=
  rfl

/-- The image of a substructure along a homomorphism. -/
@[simps]
def map (φ : M →[L] N) (A : L.Substructure M) : L.Substructure N where
  carrier s := φ s '' A s
  fun_mem f y hy := by
    choose x hxA hxy using hy
    have hy : y = (Interpret.ofFn x).map φ := Interpret.ext fun s i => by simp [hxy]
    refine ⟨funMap f (Interpret.ofFn x), A.fun_mem f _ fun s i => ?_, ?_⟩
    · rw [Interpret.get_ofFn]
      exact hxA s i
    · rw [hy, Hom.map_fun]

theorem mem_map {φ : M →[L] N} {A : L.Substructure M} {y : N s} :
    y ∈ A.map φ s ↔ ∃ x ∈ A s, φ s x = y :=
  Iff.rfl

theorem mem_map_of_mem (φ : M →[L] N) {A : L.Substructure M} {x : M s} (hx : x ∈ A s) :
    φ s x ∈ A.map φ s :=
  Set.mem_image_of_mem _ hx

theorem apply_coe_mem_map (φ : M →[L] N) (A : L.Substructure M) (x : A s) :
    φ s x ∈ A.map φ s :=
  mem_map_of_mem φ x.2

theorem map_map (g : N →[L] P) (f : M →[L] N) (A : L.Substructure M) :
    (A.map f).map g = A.map (g.comp f) :=
  DFunLike.coe_injective (funext fun _ => Set.image_image _ _ _)

theorem map_le_iff_le_comap {φ : M →[L] N} {A : L.Substructure M} {B : L.Substructure N} :
    A.map φ ≤ B ↔ A ≤ B.comap φ :=
  forall_congr' fun _ => Set.image_subset_iff

theorem gc_map_comap (φ : M →[L] N) : GaloisConnection (map φ) (comap φ) :=
  fun _ _ => map_le_iff_le_comap

theorem map_le_of_le_comap {φ : M →[L] N} {B : L.Substructure N} :
    A ≤ B.comap φ → A.map φ ≤ B :=
  (gc_map_comap φ).l_le

theorem le_comap_of_map_le {φ : M →[L] N} {B : L.Substructure N} :
    A.map φ ≤ B → A ≤ B.comap φ :=
  (gc_map_comap φ).le_u

theorem le_comap_map {φ : M →[L] N} : A ≤ (A.map φ).comap φ :=
  (gc_map_comap φ).le_u_l _

theorem map_comap_le {φ : M →[L] N} {B : L.Substructure N} : (B.comap φ).map φ ≤ B :=
  (gc_map_comap φ).l_u_le _

theorem monotone_map {φ : M →[L] N} : Monotone (map φ) :=
  (gc_map_comap φ).monotone_l

theorem monotone_comap {φ : M →[L] N} : Monotone (comap φ) :=
  (gc_map_comap φ).monotone_u

theorem map_sup (A B : L.Substructure M) (φ : M →[L] N) : (A ⊔ B).map φ = A.map φ ⊔ B.map φ :=
  (gc_map_comap φ).l_sup

theorem map_iSup {ι : Sort*} (φ : M →[L] N) (A : ι → L.Substructure M) :
    (⨆ i, A i).map φ = ⨆ i, (A i).map φ :=
  (gc_map_comap φ).l_iSup

theorem comap_inf (A B : L.Substructure N) (φ : M →[L] N) :
    (A ⊓ B).comap φ = A.comap φ ⊓ B.comap φ :=
  (gc_map_comap φ).u_inf

theorem comap_iInf {ι : Sort*} (φ : M →[L] N) (A : ι → L.Substructure N) :
    (⨅ i, A i).comap φ = ⨅ i, (A i).comap φ :=
  (gc_map_comap φ).u_iInf

@[simp]
theorem map_bot (φ : M →[L] N) : (⊥ : L.Substructure M).map φ = ⊥ :=
  (gc_map_comap φ).l_bot

@[simp]
theorem comap_top (φ : M →[L] N) : (⊤ : L.Substructure N).comap φ = ⊤ :=
  (gc_map_comap φ).u_top

@[simp]
theorem map_id (A : L.Substructure M) : A.map (Hom.id L M) = A :=
  ext fun _ _ => ⟨fun ⟨_, h, rfl⟩ => h, fun h => ⟨_, h, rfl⟩⟩

theorem map_closure (φ : M →[L] N) (X : ∀ s, Set (M s)) :
    (closure L X).map φ = closure L fun s => φ s '' X s :=
  le_antisymm
    (map_le_iff_le_comap.2 <| (closure_le (A := (closure L fun s => φ s '' X s).comap φ)).2
      fun _ _ hx => subset_closure ⟨_, hx, rfl⟩)
    (closure_le.2 fun _ _ ⟨_, hx, h⟩ => h ▸ mem_map_of_mem φ (subset_closure hx))

@[simp]
theorem closure_image (φ : M →[L] N) :
    closure L (fun s => φ s '' X s) = (closure L X).map φ :=
  (map_closure φ X).symm

/-! ### The induced structure -/

/-- The structure induced on a substructure. -/
instance inducedStructure {A : L.Substructure M} : L.Structure fun s => ↥(A s) where
  funMap f x := ⟨funMap f (x.map fun _ a => a.1), A.fun_mem f _ fun s i => by
    rw [Interpret.get_map]
    exact (x.get s i).2⟩
  RelMap r x := RelMap r (x.map fun _ a => a.1)

/-- The inclusion of a substructure, as an embedding. -/
def subtype (A : L.Substructure M) : (fun s => ↥(A s)) ↪[L] M where
  toEmbedding _ := Function.Embedding.subtype _
  map_fun' _ _ := rfl
  map_rel' _ _ := Iff.rfl

@[simp]
theorem subtype_apply (A : L.Substructure M) (x : A s) : A.subtype s x = x :=
  rfl

@[simp]
theorem coe_subtype (A : L.Substructure M) : ⇑A.subtype = fun _ => Subtype.val :=
  rfl

theorem subtype_injective (A : L.Substructure M) (s : S) : Function.Injective (A.subtype s) :=
  Subtype.coe_injective

/-- The top substructure is isomorphic to the structure itself. -/
def topEquiv : (fun s => ↥((⊤ : L.Substructure M) s)) ≃[L] M where
  toEquiv _ := Equiv.Set.univ _
  map_fun' _ _ := rfl
  map_rel' _ _ := Iff.rfl

@[simp]
theorem topEquiv_apply (x : (⊤ : L.Substructure M) s) : topEquiv s x = x :=
  rfl

/-- A formula holds of a tuple in the top substructure iff it holds of the tuple in `M`. -/
theorem realize_formula_top {σ : Arity S} (φ : L.Formula σ)
    (x : (fun s => ↥((⊤ : L.Substructure M) s)) [^] σ) :
    φ.Realize x ↔ φ.Realize (x.map fun _ a => a.1) :=
  (topEquiv.realize_formula φ x).symm

end Substructure

/-! ### Ranges and restrictions of maps -/

namespace Hom

/-- The restriction of a homomorphism to a substructure of its domain. -/
def domRestrict (φ : M →[L] N) (A : L.Substructure M) : (fun s => ↥(A s)) →[L] N :=
  φ.comp A.subtype.toHom

@[simp]
theorem domRestrict_apply (φ : M →[L] N) (A : L.Substructure M) {s : S} (x : A s) :
    φ.domRestrict A s x = φ s x :=
  rfl

/-- A homomorphism with values in a substructure, as a homomorphism into it. -/
def codRestrict (B : L.Substructure N) (φ : M →[L] N) (h : ∀ s x, φ s x ∈ B s) :
    M →[L] fun s => ↥(B s) where
  toFun s x := ⟨φ s x, h s x⟩
  map_fun' f x :=
    Subtype.ext ((φ.map_fun f x).trans (congrArg (funMap f) (by rw [Interpret.map_map]; rfl)))
  map_rel' r x hx := by
    change RelMap r ((x.map fun s a => (⟨φ s a, h s a⟩ : ↥(B s))).map fun _ a => a.1)
    rw [Interpret.map_map]
    exact φ.map_rel r x hx

@[simp]
theorem codRestrict_apply (B : L.Substructure N) (φ : M →[L] N) {h} {s : S} (x : M s) :
    (codRestrict B φ h s x : N s) = φ s x :=
  rfl

@[simp]
theorem subtype_comp_codRestrict (B : L.Substructure N) (φ : M →[L] N) (h : ∀ s x, φ s x ∈ B s) :
    B.subtype.toHom.comp (codRestrict B φ h) = φ :=
  rfl

/-- The range of a homomorphism, as a substructure. -/
def range (φ : M →[L] N) : L.Substructure N :=
  (⊤ : L.Substructure M).map φ

theorem range_eq_map (φ : M →[L] N) : φ.range = (⊤ : L.Substructure M).map φ :=
  rfl

theorem mem_range {φ : M →[L] N} {s : S} {y : N s} : y ∈ φ.range s ↔ ∃ x, φ s x = y := by
  simp [range]

@[simp]
theorem coe_range (φ : M →[L] N) : ⇑φ.range = fun s => Set.range (φ s) := by
  ext s y
  exact mem_range

theorem mem_range_self (φ : M →[L] N) {s : S} (x : M s) : φ s x ∈ φ.range s :=
  mem_range.2 ⟨x, rfl⟩

@[simp]
theorem range_id : (Hom.id L M).range = ⊤ :=
  Substructure.ext fun _ x => by simp

theorem range_comp (f : M →[L] N) (g : N →[L] P) : (g.comp f).range = f.range.map g :=
  (Substructure.map_map g f ⊤).symm

theorem range_comp_le_range (f : M →[L] N) (g : N →[L] P) : (g.comp f).range ≤ g.range :=
  range_comp f g ▸ Substructure.monotone_map le_top

theorem range_eq_top {φ : M →[L] N} : φ.range = ⊤ ↔ ∀ s, Function.Surjective (φ s) := by
  simp [Substructure.ext_iff, Function.Surjective]

theorem map_le_range {φ : M →[L] N} {A : L.Substructure M} : A.map φ ≤ φ.range :=
  Substructure.monotone_map le_top

/-- The elements on which two homomorphisms agree, as a substructure. -/
def eqLocus (f g : M →[L] N) : L.Substructure M where
  carrier s := {x | f s x = g s x}
  fun_mem c x hx := by
    change f _ (funMap c x) = g _ (funMap c x)
    rw [f.map_fun, g.map_fun]
    exact congrArg (funMap c)
      (Interpret.ext fun s i => by simp only [Interpret.get_map]; exact hx s i)

@[simp]
theorem mem_eqLocus {f g : M →[L] N} {s : S} {x : M s} : x ∈ f.eqLocus g s ↔ f s x = g s x :=
  Iff.rfl

/-- Two homomorphisms that agree on a family of sets agree on the substructure it generates. -/
theorem eqOn_closure {f g : M →[L] N} {X : ∀ s, Set (M s)}
    (h : ∀ s, Set.EqOn (f s) (g s) (X s)) (s : S) :
    Set.EqOn (f s) (g s) (Substructure.closure L X s) :=
  fun _ hx => (Substructure.closure_le (A := f.eqLocus g)).2 h s hx

theorem eq_of_eqOn_top {f g : M →[L] N} (h : ∀ s, Set.EqOn (f s) (g s) Set.univ) : f = g :=
  Hom.ext fun s x => h s (Set.mem_univ x)

theorem eq_of_eqOn_dense {X : ∀ s, Set (M s)} (hX : Substructure.closure L X = ⊤)
    {f g : M →[L] N} (h : ∀ s, Set.EqOn (f s) (g s) (X s)) : f = g :=
  eq_of_eqOn_top fun s x _ => eqOn_closure h s (hX ▸ Substructure.mem_top x)

end Hom

namespace Embedding

/-- The restriction of an embedding to a substructure of its domain. -/
def domRestrict (φ : M ↪[L] N) (A : L.Substructure M) : (fun s => ↥(A s)) ↪[L] N :=
  φ.comp A.subtype

@[simp]
theorem domRestrict_apply (φ : M ↪[L] N) (A : L.Substructure M) {s : S} (x : A s) :
    φ.domRestrict A s x = φ s x :=
  rfl

/-- An embedding with values in a substructure, as an embedding into it. -/
def codRestrict (B : L.Substructure N) (φ : M ↪[L] N) (h : ∀ s x, φ s x ∈ B s) :
    M ↪[L] fun s => ↥(B s) where
  toEmbedding s :=
    ⟨fun x => ⟨φ s x, h s x⟩, fun _ _ hxy => φ.injective s (congrArg Subtype.val hxy)⟩
  map_fun' f x :=
    Subtype.ext ((φ.map_fun f x).trans (congrArg (funMap f) (by rw [Interpret.map_map]; rfl)))
  map_rel' r x := by
    change RelMap r ((x.map fun s a => (⟨φ s a, h s a⟩ : ↥(B s))).map fun _ a => a.1) ↔ _
    rw [Interpret.map_map]
    exact φ.map_rel r x

@[simp]
theorem codRestrict_apply (B : L.Substructure N) (φ : M ↪[L] N) {h} {s : S} (x : M s) :
    (codRestrict B φ h s x : N s) = φ s x :=
  rfl

@[simp]
theorem subtype_comp_codRestrict (B : L.Substructure N) (φ : M ↪[L] N) (h : ∀ s x, φ s x ∈ B s) :
    B.subtype.comp (codRestrict B φ h) = φ :=
  rfl

/-- An embedding is an isomorphism onto its range. -/
noncomputable def equivRange (φ : M ↪[L] N) : M ≃[L] fun s => ↥(φ.toHom.range s) :=
  let ψ := codRestrict φ.toHom.range φ fun _ x => φ.toHom.mem_range_self x
  { toEquiv := fun s => Equiv.ofBijective (ψ s)
      ⟨ψ.injective s, fun ⟨_, x, _, hx⟩ => ⟨x, Subtype.ext hx⟩⟩
    map_fun' := ψ.map_fun
    map_rel' := ψ.map_rel }

@[simp]
theorem equivRange_apply (φ : M ↪[L] N) {s : S} (x : M s) : (φ.equivRange s x : N s) = φ s x :=
  rfl

end Embedding

namespace Equiv

theorem toHom_range (φ : M ≃[L] N) : φ.toHom.range = ⊤ :=
  Hom.range_eq_top.2 fun s => (φ.bijective s).2

end Equiv

namespace Substructure

/-- The inclusion of a smaller substructure in a larger one, as an embedding. -/
def inclusion {A B : L.Substructure M} (h : A ≤ B) :
    (fun s => ↥(A s)) ↪[L] fun s => ↥(B s) :=
  Embedding.codRestrict B A.subtype fun s x => h s x.2

@[simp]
theorem coe_inclusion {A B : L.Substructure M} (h : A ≤ B) {s : S} (x : A s) :
    (inclusion h s x : M s) = x :=
  rfl

@[simp]
theorem subtype_comp_inclusion {A B : L.Substructure M} (h : A ≤ B) :
    B.subtype.comp (inclusion h) = A.subtype :=
  rfl

theorem range_subtype (A : L.Substructure M) : A.subtype.toHom.range = A :=
  ext fun _ x => ⟨fun ⟨y, _, h⟩ => h ▸ y.2, fun hx => ⟨⟨x, hx⟩, Set.mem_univ _, rfl⟩⟩

end Substructure

end ManySorted.Language
